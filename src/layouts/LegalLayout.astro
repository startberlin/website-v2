---
import Layout from './Layout.astro';
import type { PageSeo } from '../lib/seo/metadata';

interface Props {
	title: string;
	seo: PageSeo;
}

const { title, seo } = Astro.props;
---

<Layout seo={seo}>
	<article class="legal-page page-container" aria-labelledby="legal-title">
		<h1 id="legal-title">{title}</h1>
		<div class="legal-page__content"><slot /></div>
	</article>
</Layout>

<style>
	.legal-page { padding-block: var(--space-20); }
	h1 {
		margin: 0 0 var(--space-12);
		font-size: var(--type-legal-title);
		font-weight: var(--weight-display);
		line-height: 1.1;
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}
	.legal-page__content {
		color: var(--text-copy);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
		overflow-wrap: anywhere;
	}
	.legal-page__content :global(.legal-chapter + .legal-chapter) { margin-top: var(--space-10); }
	.legal-page__content :global(.legal-section + .legal-section) { margin-top: var(--space-8); }
	.legal-page__content :global(.legal-paragraph) { margin-top: var(--space-6); }
	.legal-page__content :global(h2),
	.legal-page__content :global(h3),
	.legal-page__content :global(h4) {
		color: var(--color-white);
		font-weight: var(--weight-display);
		line-height: 1.35;
	}
	.legal-page__content :global(h2) {
		margin: 0 0 var(--space-4);
		font-size: var(--text-2xl);
		text-transform: uppercase;
	}
	.legal-page__content :global(h3) {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
		text-transform: uppercase;
	}
	.legal-page__content :global(h4) {
		margin: 0 0 var(--space-3);
		font-size: var(--text-lg);
	}
	.legal-page__content :global(p) { margin: 0 0 var(--space-4); }
	.legal-page__content :global(p:last-child) { margin-bottom: 0; }
	.legal-page__content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.legal-page__content :global(a:hover) { text-decoration-thickness: var(--border-width-accent); }
	.legal-page__content :global(.legal-related) { margin-top: var(--space-10); }
</style>
