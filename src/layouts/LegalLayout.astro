---
import Layout from './Layout.astro';
import PageHero from '../components/PageHero.astro';
import eventAudience from '../assets/hero/hero-4.jpg';
import type { PageSeo } from '../lib/seo/metadata';

interface Props {
	title: readonly [string, string];
	seo: PageSeo;
}

const { title, seo } = Astro.props;
---

<Layout seo={seo}>
	<PageHero title={title} titleId="legal-title" image={eventAudience} imagePosition="50% 45%" mobileImagePosition="68% 50%" />
	<article class="page-container page-flow" aria-labelledby="legal-title">
		<div class="legal-page__content readable"><slot /></div>
	</article>
</Layout>

<style>
	.legal-page__content {
		color: var(--text-copy);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
		overflow-wrap: anywhere;
	}
	.legal-page__content :global(.legal-chapter + .legal-chapter) { margin-top: var(--space-10); }
	.legal-page__content :global(.legal-section + .legal-section) { margin-top: var(--space-8); }
	.legal-page__content :global(.legal-paragraph) { margin-top: var(--space-6); }
	.legal-page__content :global(h2),
	.legal-page__content :global(h3),
	.legal-page__content :global(h4) {
		color: var(--color-white);
		font-weight: var(--weight-display);
		line-height: var(--leading-ui);
	}
	.legal-page__content :global(h2) {
		margin: 0 0 var(--space-4);
		font-size: var(--text-2xl);
		text-transform: uppercase;
	}
	.legal-page__content :global(h3) {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
		text-transform: uppercase;
	}
	.legal-page__content :global(h4) {
		margin: 0 0 var(--space-3);
		font-size: var(--text-lg);
	}
	.legal-page__content :global(p) { margin: 0 0 var(--space-4); }
	.legal-page__content :global(p:last-child) { margin-bottom: 0; }
	.legal-page__content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.legal-page__content :global(a:hover) { text-decoration-thickness: var(--border-width-accent); }
	.legal-page__content :global(.legal-related) { margin-top: var(--space-10); }
</style>
