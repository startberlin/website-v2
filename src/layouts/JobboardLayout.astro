---
import Layout from './Layout.astro';
import PageHero from '../components/PageHero.astro';
import companyVisit from '../assets/jobboard/company-visit.webp';
import '../styles/jobboard.css';
import type { PageSeo } from '../lib/seo/metadata';

interface Props {
	seo: PageSeo;
	title: readonly [string, string];
	description: string;
	compactTitle?: boolean;
}

const { seo, title, description, compactTitle } = Astro.props;
---

<Layout seo={seo}>
	<div class="jobboard">
		<PageHero title={title} image={companyVisit} imagePosition="50% 57%" mobileImagePosition="58% 55%" compactTitle={compactTitle}>
			<Fragment slot="description">{description}</Fragment>
			<Fragment slot="aside"><slot name="hero-action" /></Fragment>
		</PageHero>
		<div class="jb-page page-container page-flow" id="jobboard-content">
			<slot />
		</div>
	</div>
</Layout>
