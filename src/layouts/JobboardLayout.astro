---
import Layout from './Layout.astro';
import '../styles/jobboard.css';
import type { PageSeo } from '../lib/seo/metadata';

interface Props {
	seo: PageSeo;
}

const { seo } = Astro.props;
const hasHero = Astro.slots.has('hero');
---

<Layout seo={seo}>
	<div class:list={['jobboard', { 'jobboard--hero': hasHero }]}>
		<a class="jb-skip" href="#jobboard-content">Skip to jobs content</a>
		<slot name="hero" />
		<div class="jb-page page-container" id="jobboard-content">
			<slot />
		</div>
	</div>
</Layout>

<style>
	.jb-skip { position: absolute; top: -6rem; left: 1rem; padding: var(--space-3) var(--space-4); background: var(--color-white); color: var(--color-dark-blue); z-index: var(--z-skip-link); }
	.jb-skip:focus { top: 5.5rem; }
</style>
