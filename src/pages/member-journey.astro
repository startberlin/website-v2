---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import JourneyStages from '../components/member-journey/JourneyStages.astro';
import { pageSeo } from '../lib/seo/pages';
import { departments, departmentsSection, game, hero, memberStories, stages, storiesSection } from '../data/member-journey';

// Skeleton: the departments and stories sections get their designed components
// in the following steps. No call to action while applications are closed.
---

<Layout seo={pageSeo('/member-journey')}>
	<PageHero>
		<Fragment slot="title">
			<span data-hero-line data-hero-accent>{hero.accent}</span>{' '}
			<span data-hero-line data-hero-outline>{hero.outline}</span>
		</Fragment>
	</PageHero>

	<JourneyStages stages={stages} />

	<section class="section page-container" id="departments" aria-labelledby="departments-heading">
		<h2 id="departments-heading" class="section__title">
			{departmentsSection.headingSolid} {departmentsSection.headingOutline}
		</h2>
		<p class="section__lead">{departmentsSection.subheading}</p>
		{departments.map((department) => (
			<article id={`department-${department.id}`}>
				<h3>{department.name}</h3>
				{department.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</article>
		))}
	</section>

	{/* Rendered only once the shared game is integrated; see game in src/data/member-journey.ts. */}
	{game.enabled && <section id={game.id} class="game page-container"></section>}

	<section class="section page-container" id="member-stories" aria-labelledby="member-stories-heading">
		<h2 id="member-stories-heading" class="section__title">{storiesSection.heading}</h2>
		<p class="section__lead">{storiesSection.subheading}</p>
		{memberStories.map((story) => (
			<figure>
				<blockquote><p>“{story.quote}”</p></blockquote>
				<figcaption>{story.name}, {story.role}</figcaption>
			</figure>
		))}
	</section>
</Layout>

<style>
	.section {
		padding-block: var(--space-16);
	}

	.section__title {
		margin: 0 0 var(--space-6);
		font-size: var(--type-section);
		font-weight: var(--weight-display);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.section__lead {
		max-width: var(--layout-reading);
		color: var(--text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
	}

	.game {
		min-height: 20rem;
	}
</style>
