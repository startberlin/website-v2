---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Testimonial from '../components/Testimonial.astro';
import PersonChip from '../components/PersonChip.astro';
import StartStar from '../components/StartStar.astro';
import Icon from '../components/icons/Icon.astro';
import { pageSeo } from '../lib/seo/pages';
import { boardMembers, boardProfilePath, type TeamSeason } from '../lib/board-members';
import { memberProfiles } from '../lib/member-profiles';
import team from '../data/team.json';
import { community, departmentSummaries, hero, join, network, organisation, purpose } from '../data/about-us';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/members/*.webp', { eager: true });
const portraitFor = (name: string) => {
	const file = memberProfiles[name]?.portrait;
	return file ? portraits[`../assets/members/${file}`]?.default : undefined;
};

// Each department with its approved summary sentence and its board head from the
// current season.
const season = team.seasons[0] as TeamSeason;
const departmentRows = departmentSummaries.map((department) => {
	const head = season.departments.find((entry) => entry.name === department.name)?.members.find((member) => member.board);
	return { ...department, head };
});
// President, Vice President and Head of Finance, as in the first Members board row.
const leadership = boardMembers.filter((member) => ['President', 'Vice President', 'Head of Finance'].includes(member.role));

// Never request more pixels than the source has.
const bandWidths = [...[640, 1080, 1600].filter((width) => width < community.photo.src.width), Math.min(community.photo.src.width, 2400)];
---

<Layout seo={pageSeo('/about-us')}>
	<PageHero>
		<div slot="background" class="hero-glow" aria-hidden="true"></div>
		<Fragment slot="title">
			<span data-hero-line data-hero-accent>{hero.accent}</span>{' '}
			<span data-hero-line data-hero-outline>{hero.outline}</span>
		</Fragment>
		<Fragment slot="description">{hero.description}</Fragment>
		<div slot="actions" class="hero-actions">
			<a class="button" href={join.primary.href}>{join.primary.label}</a>
			<a class="button button--outline" href="/members">Meet our members</a>
		</div>
		<div slot="aside" class="hero-star"><StartStar mode="assemble" sizes="(min-width: 64rem) 28rem, 60vw" /></div>
	</PageHero>

	<section class="section page-container purpose" id="purpose" aria-labelledby="purpose-heading">
		<div class="purpose__copy">
			<SectionHeading id="purpose-heading">{purpose.heading}</SectionHeading>
			<div class="prose">
				{purpose.text.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
		<div class="purpose__voice"><Testimonial {...purpose.voice} featured variant="pull" /></div>
	</section>

	<section class="photo-band" id="community" aria-labelledby="community-heading">
		<Image src={community.photo.src} alt={community.photo.alt} widths={bandWidths} sizes="100vw" format="webp" loading="lazy" class="photo-band__image" />
		<div class="photo-band__shade" aria-hidden="true"></div>
		<div class="section page-container photo-band__content">
			<SectionHeading id="community-heading">
				{community.headingSolid}{' '}<span data-outline>{community.headingOutline}</span>
			</SectionHeading>
			<div class="prose">
				{community.text.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<div class="photo-band__voice"><Testimonial {...community.voice} variant="pull" /></div>
		</div>
	</section>

	<section class="band" id="organisation" aria-labelledby="organisation-heading">
		<div class="section page-container">
			<SectionHeading id="organisation-heading">
				{organisation.heading}
				<Fragment slot="lead">{organisation.lead}</Fragment>
			</SectionHeading>
			<ul class="departments" role="list">
				{departmentRows.map((row) => (
					<li class="department">
						<h3 class="department__name">{row.name}</h3>
						<p class="department__intro">{row.summary}</p>
						{row.head && (
							<div class="department__head">
								<PersonChip name={row.head.name} role={row.head.role ?? `Head of ${row.name}`} portrait={portraitFor(row.head.name)} profileUrl={boardProfilePath(row.head.name)} />
							</div>
						)}
					</li>
				))}
			</ul>
			<a class="text-link" href={organisation.moreLink.href}>{organisation.moreLink.label} <Icon name="arrow-right" size={18} /></a>

			<h3 class="subheading">{organisation.boardHeading}</h3>
			<ul class="board" role="list">
				{leadership.map((member) => (
					<li><PersonChip name={member.name} role={member.role} portrait={portraitFor(member.name)} profileUrl={`/members/${member.slug}`} /></li>
				))}
			</ul>
		</div>
	</section>

	<section class="network" id="network" aria-labelledby="network-heading">
		<div class="network__glow" aria-hidden="true"></div>
		<div class="section page-container network__layout">
			<div class="network__copy">
				<SectionHeading id="network-heading">{network.heading}</SectionHeading>
				<div class="prose">
					{network.text.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<dl class="stats" data-count-group>
					{network.stats.map((stat) => (
						<div class="stat">
							<dt class="stat__label">{stat.label}</dt>
							<dd class="stat__value">
								<span aria-hidden="true" data-count={stat.value}>{stat.value}</span>
								<span class="sr-only">{stat.value}</span>
							</dd>
						</div>
					))}
				</dl>
			</div>
			<div class="network__voice"><Testimonial {...network.voice} variant="pull" /></div>
		</div>
	</section>

	<section class="section page-container" id="join" aria-labelledby="join-heading">
		<div class="join">
			<div class="join__copy">
				<h2 class="join__heading" id="join-heading">{join.heading}</h2>
				<p class="join__text">{join.text}</p>
				<a class="button" href={join.primary.href}>{join.primary.label}</a>
			</div>
			<ul class="join__links" role="list">
				{join.links.map((link) => (
					<li><a class="join__link" href={link.href}>{link.label} <Icon name="arrow-right" size={20} /></a></li>
				))}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.section {
		padding-block: var(--space-16);
	}

	.prose {
		display: grid;
		gap: var(--space-4);
		max-width: var(--layout-reading);
	}

	.prose p {
		margin: 0;
		color: var(--text-copy);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
	}

	/* Hero: a soft star-blue glow behind the star instead of flat navy. */
	.hero-glow {
		position: absolute;
		inset: 0;
		z-index: -2;
		background: var(--gradient-glow-deep) 85% 40% / 70% 120% no-repeat, var(--gradient-glow) 80% 45% / 40% 70% no-repeat;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.hero-star {
		width: clamp(13rem, 36vw, 28rem);
		margin-inline: auto;
	}

	/* Below 640 px the hero aside wraps under the copy; let it span the row so the
	   star centres instead of hugging the left edge. */
	@media (max-width: 639px) {
		:global(.page-hero__aside:has(> .hero-star)) { width: 100%; }
		.hero-star { width: min(16rem, 70%); }
	}

	/* Purpose: copy beside the featured quote. */
	.purpose {
		display: grid;
		gap: var(--space-12);
	}

	.purpose__copy,
	.purpose__voice {
		min-width: 0;
	}

	@media (min-width: 1024px) {
		.purpose { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-16); align-items: center; }
	}

	/* Community: the page's photo band, as on Join. */
	.photo-band {
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	/* Phones: the photo stands on its own above the text. From 768 px it fills the
	   band behind the text with the shared photo-band shade, as on Join. */
	.photo-band__image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: 70% 40%;
	}

	.photo-band__shade {
		display: none;
	}

	.photo-band__content {
		display: grid;
		justify-items: start;
	}

	.photo-band__content > :global(*) {
		max-width: 40rem;
	}

	.photo-band__voice {
		margin-top: var(--space-10);
	}

	@media (min-width: 768px) {
		.photo-band__image,
		.photo-band__shade {
			position: absolute;
			inset: 0;
			z-index: -1;
			display: block;
			width: 100%;
			height: 100%;
			aspect-ratio: auto;
		}

		.photo-band__shade { background: var(--gradient-photo-band); }
		.photo-band__content { padding-block: var(--space-28); }
	}

	/* Organisation: a clearly bluer band with hard edges. */
	.band {
		background: var(--surface-band);
	}

	.departments {
		display: grid;
		margin: 0 0 var(--space-8);
		padding: 0;
		list-style: none;
		border-top: var(--border-width) solid var(--border-default);
	}

	.department {
		display: grid;
		gap: var(--space-3) var(--space-8);
		padding-block: var(--space-6);
		border-bottom: var(--border-width) solid var(--border-default);
	}

	.department__name {
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: var(--weight-display);
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.department__intro {
		margin: 0;
		color: var(--text-copy);
		line-height: var(--leading-copy);
	}

	/* Wide enough that "Operations & Digital" stays on one line; columns align to the
	   top so wrapped head names look intentional. */
	@media (min-width: 1024px) {
		.department {
			grid-template-columns: 20rem minmax(0, 1fr) 16rem;
			align-items: start;
		}

		.department__head :global(.person) { align-items: start; }
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--target-min);
		color: var(--color-accent);
		font-weight: var(--weight-bold);
	}

	.subheading {
		margin: var(--space-16) 0 var(--space-6);
		color: var(--text-muted);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.board {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6) var(--space-12);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Network: copy and figures beside Rhema's view from across the chapters. */
	.network {
		container: network / inline-size;
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.network__glow {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--gradient-glow) 0% 60% / 60% 90% no-repeat, var(--gradient-glow-deep) 100% 30% / 70% 100% no-repeat;
	}

	.network__layout {
		display: grid;
		gap: var(--space-14);
	}

	.network__copy,
	.network__voice {
		min-width: 0;
	}

	.network__voice {
		align-self: center;
	}

	@container network (min-width: 60rem) {
		.network__layout { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-16); }
	}

	/* Four figures as a 2 × 2 grid so no value wraps. */
	.stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-8) var(--space-6);
		max-width: var(--layout-reading);
		margin: var(--space-10) 0 0;
		padding-top: var(--space-8);
		border-top: var(--border-width) solid var(--border-default);
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: var(--space-2);
		min-width: 0;
	}

	.stat__label {
		color: var(--text-muted);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.stat__value {
		margin: 0;
		color: var(--color-accent);
		font-size: var(--type-stat);
		font-weight: var(--weight-display);
		/* Equal-width digits so counting up does not jitter. */
		font-variant-numeric: tabular-nums;
		line-height: 1;
		white-space: nowrap;
	}

	/* Join: the closing call to action on the accent surface. */
	.join {
		display: grid;
		gap: var(--space-10);
		padding: var(--space-10) var(--space-6);
		border: var(--border-width) solid var(--border-accent);
		border-radius: var(--radius-media);
		background: var(--surface-accent);
	}

	.join__copy {
		display: grid;
		gap: var(--space-5);
		justify-items: start;
		min-width: 0;
	}

	.join__heading {
		margin: 0;
		font-size: var(--type-section);
		font-weight: var(--weight-display);
		letter-spacing: -0.025em;
		line-height: 0.95;
		text-transform: uppercase;
	}

	.join__text {
		max-width: 32rem;
		margin: 0;
		color: var(--text-copy);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
	}

	.join__links {
		display: grid;
		align-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.join__link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: var(--target-min);
		padding-block: var(--space-4);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		border-bottom: var(--border-width) solid var(--border-default);
		transition: color var(--duration-fast);
	}

	.join__link:hover {
		color: var(--color-accent);
	}

	@media (min-width: 768px) {
		.join { padding: var(--space-14) var(--space-12); }
	}

	@media (min-width: 1024px) {
		.join { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-16); }
	}

	@media (min-width: 1024px) {
		.section { padding-block: var(--space-24); }
	}

	@media (prefers-reduced-motion: reduce) {
		.join__link { transition: none; }
	}
</style>

<script>
	// Count the network figures up once when they scroll into view, slightly staggered.
	// The final values stay in the HTML (search engines, no JavaScript, slow devices)
	// and screen readers read the hidden copy; reduced motion shows them still.
	const group = document.querySelector<HTMLElement>('[data-count-group]');

	if (group && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const counters = [...group.querySelectorAll<HTMLElement>('[data-count]')];
		const observer = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) return;
			observer.disconnect();
			counters.forEach((counter, index) => {
				// Keep prefixes, suffixes and digit grouping, e.g. "+1800" or "1,800+".
				const [, prefix = '', digits = '', suffix = ''] = counter.dataset.count?.match(/^(\D*)([\d,]+)(\D*)$/) ?? [];
				const target = Number(digits.replace(/,/g, ''));
				if (!target) return;
				const format = (value: number) => prefix + (digits.includes(',') ? value.toLocaleString('en-GB') : String(value)) + suffix;
				const delay = index * 120;
				let start: number | undefined;
				// The first frame sets 0, so a count that never gets a frame keeps the final value.
				const step = (now: number) => {
					start ??= now + delay;
					const progress = Math.min(Math.max((now - start) / 1600, 0), 1);
					counter.textContent = format(Math.round(target * (1 - (1 - progress) ** 3)));
					if (progress < 1) requestAnimationFrame(step);
				};
				requestAnimationFrame(step);
			});
		}, { threshold: 0.4 });
		observer.observe(group);
	}
</script>
