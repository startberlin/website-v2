---
import JobboardLayout from '../../layouts/JobboardLayout.astro';
import { SubmissionForm } from '../../components/jobboard/SubmissionForm';
import { pageSeo } from '../../lib/seo/pages';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<JobboardLayout
	seo={pageSeo('/jobs/submit')}
	title={['Post a', 'role']}
	description="Share an opening with the START network."
>
	<a slot="hero-action" class="text-action" href="/jobs">All jobs <span aria-hidden="true">↗</span></a>
	<p class="submission-introduction">We will review your role and contact you to agree on publication terms.</p>
	<SubmissionForm client:load />
</JobboardLayout>

<style>
	.submission-introduction {
		max-width: var(--layout-reading);
		margin: 0;
		color: var(--text-copy);
		line-height: var(--leading-copy);
	}
</style>
