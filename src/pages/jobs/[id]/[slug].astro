---
import JobboardLayout from '../../../layouts/JobboardLayout.astro';
import Icon from '../../../components/icons/Icon.astro';
import { getJob, CockpitError, publicSiteUrl } from '../../../lib/jobboard/api';
import {
	displayDate, employmentLabels, isActive, jobHref, jobPath, jobPosting,
	publicJobTitle, remoteLabels, salaryLabel, seniorityLabels, sourceFrom, sourceHref,
} from '../../../lib/jobboard/public-utils';
import type { PublicJob } from '../../../lib/jobboard/contracts';
import { pageSeo } from '../../../lib/seo/pages';
import { textSnippet } from '../../../lib/seo/metadata';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id = '', slug = '' } = Astro.params;
const source = sourceFrom(Astro.url.searchParams.get('source'));
let job: PublicJob | undefined;
let origin: string | undefined;
let missing = false;
try {
	origin = publicSiteUrl(Astro.url.origin);
	job = await getJob(id);
} catch (error) {
	missing = error instanceof CockpitError && error.code === 'not_found';
	Astro.response.status = missing ? 404 : 503;
}
if (job && slug !== job.slug) return Astro.redirect(jobHref(job, source), 308);
const displayTitle = job ? publicJobTitle(job.content.title) : undefined;
const active = job ? isActive(job) : false;
if (job && active) Astro.locals.jobNavigation = { type: 'detail_request', jobId: job.id };
const canonical = job && origin ? new URL(jobPath(job), origin).href : undefined;
const structured = job && origin ? jobPosting(job, origin) : null;
const seo = {
	...pageSeo('/jobs/[id]/[slug]'),
	...(job ? { title: `${displayTitle} at ${job.company.name}`, description: textSnippet(job.content.description), canonicalPath: jobPath(job) } : {}),
	noindex: !active,
	structuredData: structured ? [structured] : [],
};

const title: [string, string] = job && displayTitle
	? [displayTitle, `at ${job.company.name}`]
	: missing ? ['This listing', 'could not be found.'] : ['This role', 'could not be loaded.'];
const description = job
	? `${job.content.locations.join(' · ')} · ${remoteLabels[job.content.remoteMode]}`
	: missing ? 'Browse the current openings.' : 'Please try again shortly.';
---

<JobboardLayout seo={seo} title={title} description={description} compactTitle>
	{!missing && <a class="text-action jb-back" href={sourceHref('/jobs', source)}><Icon name="arrow-left" size={18} /> All jobs</a>}
	{job ? (
		<>
			{!active && <section class="jb-status" role="status"><h2>This role is no longer open.</h2><p>Browse the current listings for other roles.</p><a class="text-action" href="/jobs">See open jobs</a></section>}
			<div class="jb-detail-grid">
				<article class="jb-description">
					<h2>About the role</h2>
					{job.content.description.split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
					{job.company.description && <section class="jb-company"><h2>About {job.company.name}</h2><p>{job.company.description}</p><a class="text-action" href={job.company.website} target="_blank" rel="noopener noreferrer">Company website <Icon name="external-link" size={18} /></a></section>}
					<section class="jb-sharing" aria-label="Share this role" data-role-url={canonical} data-role-title={`${displayTitle} at ${job.company.name}`}>
						<h2>Share this role</h2>
						<div>
							<a class="text-action jb-share-action" href={sourceHref(`/jobs/share/${encodeURIComponent(job.id)}/whatsapp`, 'whatsapp')} target="_blank" rel="noopener noreferrer" aria-label="Share this role on WhatsApp"><Icon name="whatsapp" size={20} /> WhatsApp</a>
							<a class="text-action jb-share-action" href={sourceHref(`/jobs/share/${encodeURIComponent(job.id)}/linkedin`, 'linkedin')} target="_blank" rel="noopener noreferrer" aria-label="Share this role on LinkedIn"><Icon name="linkedin" size={20} /> LinkedIn</a>
							<button class="text-action jb-share-action" type="button" data-share-action="share" aria-label="Share this role"><Icon name="share" size={20} /> Share</button>
							<button class="text-action jb-share-action" type="button" data-share-action="copy" aria-label="Copy link to this role"><Icon name="copy" size={20} /> Copy link</button>
						</div>
						<p class="jb-share-status" data-role-share-status aria-live="polite" aria-atomic="true"></p>
					</section>
				</article>
				<aside class="jb-facts" aria-label="Role details">
					<h2>The details</h2>
					<dl>
						<div><dt>Role type</dt><dd>{employmentLabels[job.content.employmentType]}</dd></div>
						<div><dt>Experience</dt><dd>{seniorityLabels[job.content.seniority]}</dd></div>
						<div><dt>Compensation</dt><dd>{salaryLabel(job.content)}</dd></div>
						<div><dt>Languages</dt><dd>{job.content.languages.join(', ')}</dd></div>
						<div><dt>Eligible countries</dt><dd>{job.content.countryCodes.join(', ')}</dd></div>
						{job.content.weeklyHours !== null && <div><dt>Hours per week</dt><dd>{job.content.weeklyHours}</dd></div>}
						{job.content.internshipDurationMonths !== null && <div><dt>Duration</dt><dd>{job.content.internshipDurationMonths} months</dd></div>}
						<div><dt>Published</dt><dd><time datetime={job.publishedAt}>{displayDate(job.publishedAt)}</time></dd></div>
						<div><dt>{active ? 'Open until' : 'Listing end date'}</dt><dd><time datetime={job.expiresAt}>{displayDate(job.expiresAt)}</time></dd></div>
					</dl>
					{active ? <><a class="button" href={sourceHref(`/jobs/apply/${encodeURIComponent(job.id)}`, source)}>Apply for this role <Icon name="arrow-up-right" size={18} /></a><p class="jb-apply-note">Continue to the employer's application page.</p></> : <p class="jb-apply-note">Applications through this listing are closed.</p>}
				</aside>
			</div>
		</>
	) : (
		<div class="jb-status">
			<a class="button" href={missing ? sourceHref('/jobs', source) : Astro.url.pathname}>{missing ? 'All jobs' : 'Try again'}</a>
		</div>
	)}
</JobboardLayout>

<script>
	import { copyRoleLink, shareRole } from '../../../lib/jobboard/share';

	document.querySelectorAll<HTMLElement>('[data-role-url]').forEach((section) => {
		const buttons = section.querySelectorAll<HTMLButtonElement>('[data-share-action]');
		const status = section.querySelector<HTMLElement>('[data-role-share-status]');
		let busy = false;
		buttons.forEach((button) => {
			button.addEventListener('click', async () => {
				const url = section.dataset.roleUrl;
				if (busy || !url) return;
				busy = true;
				section.setAttribute('aria-busy', 'true');
				buttons.forEach((control) => { control.disabled = true; });
				try {
					const copying = button.dataset.shareAction === 'copy';
					const result = copying
						? await copyRoleLink(url, navigator)
						: await shareRole({ title: section.dataset.roleTitle ?? document.title, url }, navigator);
					if (status && result !== 'cancelled') {
						status.textContent = result === 'copied' ? 'Link copied.'
							: result === 'shared' ? 'Share options opened.'
								: `${copying ? 'Could not copy the link.' : 'Could not share this role.'} Copy the page address instead.`;
					}
				} finally {
					busy = false;
					section.removeAttribute('aria-busy');
					buttons.forEach((control) => { control.disabled = false; });
				}
			});
		});
	});
</script>

<style>
	.jb-back { margin-bottom: var(--space-heading); }
	.jb-detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--space-columns); }
	.jb-description { min-width: 0; }
	.jb-description h2, .jb-facts h2 { font-size: var(--text-lg); margin: 0 0 var(--space-6); }
	.jb-description p { max-width: var(--layout-reading); white-space: pre-wrap; overflow-wrap: anywhere; line-height: var(--leading-copy); color: var(--text-copy); margin: 0 0 var(--space-6); }
	.jb-company, .jb-sharing { margin-top: var(--space-heading); padding-top: var(--space-heading); border-top: var(--border-width) solid var(--border-default); }
	.jb-sharing > div { display: flex; flex-wrap: wrap; gap: var(--space-grid); }
	.jb-sharing .jb-share-status { font-size: var(--text-sm); min-height: 1.5em; margin-top: var(--space-4); }
	.jb-facts { border-top: var(--border-width) solid var(--border-default); padding-top: var(--space-6); }
	.jb-facts dl { display: grid; gap: var(--space-5); margin: 0 0 var(--space-8); }
	.jb-facts dt { font-size: var(--text-caption); color: var(--text-muted); }
	.jb-facts dd { margin: var(--space-1) 0 0; overflow-wrap: anywhere; }
	.jb-apply-note { font-size: var(--text-caption); line-height: var(--leading-ui); color: var(--text-muted); }
	@media (width < 768px) { .jb-detail-grid { grid-template-columns: minmax(0, 1fr); } .jb-facts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
