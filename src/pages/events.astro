---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LumaEvents from '../components/LumaEvents.astro';
import { pageSeo } from '../lib/seo/pages';
import { lumaCalendar } from '../lib/luma';
import { calendarSection, formats, formatsSection, hero, membersOnly, pastEventList, pastEvents } from '../data/events';

// Never request more pixels than the source has.
const photoWidths = (photo: ImageMetadata) => [...[400, 800].filter((width) => width < photo.width), Math.min(photo.width, 1200)];
const pastByDate = [...pastEventList].sort((a, b) => b.date.localeCompare(a.date));
const dateLabel = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const formatDate = (isoDate: string) => dateLabel.format(new Date(`${isoDate}T00:00:00Z`));
---

<Layout seo={pageSeo('/events')}>
	<PageHero
		image={hero.photo.src}
		alt={hero.photo.alt}
		imagePosition={hero.imagePosition}
		mobileImagePosition={hero.mobileImagePosition}
		phoneShade
	>
		<Fragment slot="title">{hero.title}</Fragment>
		<Fragment slot="description">{hero.description}</Fragment>
	</PageHero>

	<section class="section formats-section page-container" id="formats" aria-labelledby="formats-heading">
		<SectionHeading id="formats-heading">
			{formatsSection.headingSolid}{' '}<span data-outline>{formatsSection.headingOutline}</span>
		</SectionHeading>
		<div class="formats">
			{formats.map((format) => (
				<article class="format" id={format.id}>
					<Image
						src={format.photo.src}
						alt={format.photo.alt}
						widths={photoWidths(format.photo.src)}
						sizes="(min-width: 68rem) 25rem, (min-width: 43rem) 40vw, 100vw"
						format="webp"
						loading="lazy"
						class="format__photo"
					/>
					<div class="format__body">
						<h3 class="format__title">{format.title}</h3>
						<p class="format__text">{format.text}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<LumaEvents id={calendarSection.id} heading={calendarSection.heading} lead={calendarSection.lead} />

	<section class="section page-container" id="members-only" aria-labelledby="members-only-heading">
		<div class="members-card">
			<SectionHeading id="members-only-heading">
				{membersOnly.heading}
				<Fragment slot="lead">{membersOnly.text}</Fragment>
			</SectionHeading>
			<a class="button" href={membersOnly.link.href}>{membersOnly.link.label}</a>
		</div>
	</section>

	<section class="section past-section page-container" id="past-events" aria-labelledby="past-events-heading">
		<SectionHeading id="past-events-heading">
			{pastEvents.heading}
			<Fragment slot="lead">{pastEvents.lead}</Fragment>
		</SectionHeading>
		<ol class="past-list" role="list">
			{pastByDate.map((event) => (
				<li class="past-list__item">
					<a class="past-card" href={event.url} target="_blank" rel="noopener noreferrer">
						{event.graphic && (
							<Image
								src={event.graphic}
								alt=""
								widths={photoWidths(event.graphic)}
								sizes="(min-width: 68rem) 14rem, (min-width: 43rem) 30vw, (min-width: 29rem) 45vw, 100vw"
								format="webp"
								loading="lazy"
								class="past-card__graphic"
							/>
						)}
						<span class="past-card__body">
							<h3 class="past-card__title">{event.title}</h3>
							<time class="past-card__date" datetime={event.date}>{formatDate(event.date)}</time>
							<span class="sr-only"> (opens in a new tab)</span>
						</span>
					</a>
				</li>
			))}
		</ol>
		<a class="button button--outline" href={lumaCalendar.pastEventsUrl} target="_blank" rel="noopener noreferrer">
			{pastEvents.linkLabel}<span class="sr-only"> (opens in a new tab)</span>
		</a>
	</section>
</Layout>

<style>
	.section {
		padding-block: var(--space-16);
	}

	.formats-section {
		container: formats / inline-size;
	}

	.formats {
		display: grid;
		gap: var(--space-12);
	}

	.format {
		display: grid;
		gap: var(--space-6);
		align-content: start;
		min-width: 0;
	}

	/* One 16:10 frame for every format photo, matching the Member Journey photo frame. */
	.format__photo {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
	}

	.format__body {
		min-width: 0;
	}

	.format__title {
		margin: 0 0 var(--space-4);
		font-size: var(--text-3xl);
		font-weight: var(--weight-display);
		letter-spacing: -0.025em;
		line-height: 0.95;
		text-transform: uppercase;
		hyphens: auto;
	}

	.format__text {
		max-width: var(--layout-reading);
		margin: 0;
		color: var(--text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
	}

	/* Photo beside the text on tablets, three columns once each column has room. */
	@container formats (min-width: 40rem) {
		.format {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			align-items: center;
			gap: var(--space-8);
		}
	}

	@container formats (min-width: 64rem) {
		.formats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-10); }
		.format { grid-template-columns: none; align-items: start; gap: var(--space-6); }
	}

	.past-section {
		container: past / inline-size;
	}

	.past-list {
		display: grid;
		gap: var(--space-6);
		margin: 0 0 var(--space-12);
		padding: 0;
		list-style: none;
	}

	.past-list__item {
		display: flex;
		min-width: 0;
	}

	/* The whole card is one link; the shared focus outline surrounds it. */
	.past-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		width: 100%;
		padding: var(--space-3);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
		background: var(--surface-card);
		transition: background-color var(--duration-fast), border-color var(--duration-fast);
	}

	.past-card:hover {
		border-color: var(--border-strong);
		background: var(--surface-control);
	}

	/* Square graphics at their native 800 px stay sharp up to 400 px wide at 2x; the
	   columns below keep every card near or below that width. */
	.past-card__graphic {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border-radius: var(--radius-field);
	}

	.past-card__body {
		display: grid;
		gap: var(--space-1);
		padding: 0 var(--space-1) var(--space-2);
	}

	.past-card__title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
	}

	.past-card__date {
		color: var(--text-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-ui);
	}

	@container past (min-width: 26rem) {
		.past-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@container past (min-width: 40rem) {
		.past-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}

	@container past (min-width: 64rem) {
		.past-list { grid-template-columns: repeat(5, minmax(0, 1fr)); }
	}

	/* Distinguished by its surface and border alone, as in the featured Testimonial. */
	.members-card {
		padding: var(--space-8) var(--space-6);
		border: var(--border-width) solid var(--border-accent);
		border-radius: var(--radius-card);
		background: var(--surface-accent);
	}

	@media (min-width: 768px) {
		.members-card { padding: var(--space-12); }
	}

	@media (min-width: 1024px) {
		.section { padding-block: var(--space-24); }
	}
</style>
