---
import Icon from '../components/icons/Icon.astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DepartmentTabs from '../components/member-journey/DepartmentTabs.astro';
import JoinTrips from '../components/JoinTrips.astro';
import MemberStories from '../components/MemberStories.astro';
import groupPhoto from '../assets/hero/hero-1.jpg';
import teamPhoto from '../assets/hero/hero-3.jpg';
import audiencePhoto from '../assets/join/legacy-start-event.jpg';
import visitPhoto from '../assets/join/legacy-vc-visit.jpg';
import teamLiftingPhoto from '../assets/join/team-lifting.jpg';
import { pageSeo } from '../lib/seo/pages';
import { departments, departmentsSection, membershipFee } from '../data/member-journey';

const applicationsOpen = false;
const nextApplicationRound = { label: 'April 2027', month: '2027-04' };

const links = {
	apply: 'https://forms.start-berlin.com/apply',
	contact: 'https://forms.start-berlin.com/contact',
};

const stats = [
	{ value: '500+', label: 'Alumni' },
	{ value: '54', label: 'Active Members' },
	{ value: '15+', label: 'Nationalities' },
	{ value: '5', label: 'Departments' },
];

const benefits = [
	{
		title: 'Find potential co-founders',
		text: 'Meet students in Berlin and across the international START network.',
	},
	{
		title: 'Get inside Berlin startups',
		text: 'Visit startups and talk to the founders and investors behind them.',
	},
	{
		title: 'Build practical skills',
		text: 'Learn from industry experts in workshops on topics like sales and legal basics.',
	},
];

const requirements = [
	'You are enrolled at a university',
	'You have a burning passion for entrepreneurship',
	'You want to become a founder, get into venture capital, meet prospective co-founders or learn more about the ecosystem',
	'You commit to being an active member of our community for one entire year',
	'You are based in Berlin for at least the next 6 months',
];

// Add a `date` to each step once the next round's timeline is fixed.
const steps: { title: string; text: string; date?: string }[] = [
	{
		title: 'Apply',
		text: 'Complete a short application questionnaire and upload your CV. You will receive an email confirming that we have received your application.',
	},
	{
		title: 'Interview',
		text: 'After an initial screening of the written applications, selected candidates are invited to a short interview with START members.',
	},
	{
		title: 'Onboarding',
		text: 'Your first event as an official STARTie. You meet the whole team and get to know each other. Onboarding is mandatory for new members.',
	},
];

const faqs: { question: string; answer: string }[] = [
	{
		question: 'Do I need to have a startup idea to apply?',
		answer: 'No. Many of our members join without a specific idea. START Berlin is about exploring the entrepreneurship ecosystem, meeting potential co-founders and learning how to build — whether you already have an idea or are still looking for one.',
	},
	{
		question: 'Which universities can I apply from?',
		answer: 'You can apply from any university or higher education institution in Berlin or Potsdam. We welcome students from all academic backgrounds.',
	},
	{
		question: 'How much time do I need to commit?',
		answer: 'Members commit for one full year and contribute to one of our five departments. The exact time varies by role and department, but expect to invest a few hours per week alongside regular events and meetings.',
	},
	{
		question: 'What is the membership fee?',
		answer: `Membership costs ${membershipFee.amount} ${membershipFee.period}. The fee supports events and community activities.`,
	},
	{
		question: 'When do applications open?',
		answer: applicationsOpen
			? 'Applications are open. Use the Apply now button at the top of this page to submit your application.'
			: `We usually recruit in April and October. The next round opens in ${nextApplicationRound.label}. We'll announce the opening in our newsletter.`,
	},
	{
		question: 'Can I apply if I am an exchange student?',
		answer: 'Yes, as long as you are based in Berlin for at least six months and can commit to being an active member for one full year. We have members from many countries and backgrounds.',
	},
	{
		question: 'What happens after I apply?',
		answer: 'After submitting your application, you will receive a confirmation email. Selected candidates are invited to a short interview with current START Berlin members. Successful applicants then join the mandatory onboarding event.',
	},
];

---

<Layout seo={pageSeo('/join')}>
	<div class="join-hero">
		<PageHero
			title={['How to join', 'START Berlin']}
			image={groupPhoto}
			alt="START Berlin members posing together for a group photo."
			imagePosition="50% 0%"
			mobileImagePosition="50% 50%"
		>
			<Fragment slot="description">Join Berlin's student startup community.</Fragment>
			<Fragment slot="aside">
				{applicationsOpen && <a href={links.apply} class="button hero-action">Apply now</a>}
			</Fragment>
		</PageHero>
	</div>

	<div class="section-stack page-flow">
		{!applicationsOpen && (
			<section class="page-container round" aria-labelledby="join-round-heading">
				<h2 class="round__heading" id="join-round-heading">Next application round</h2>
				<time datetime={nextApplicationRound.month} class="round__date">{nextApplicationRound.label}</time>
			</section>
		)}

		<section class="page-container benefits-section" aria-labelledby="join-benefits-heading">
			<div class="split">
				<div class="split__text">
					<SectionHeading id="join-benefits-heading">
						Inside Berlin's <span data-outline>startup scene</span>
					</SectionHeading>
					<ul class="benefits" role="list">
						{benefits.map((benefit) => (
							<li class="benefits__item">
								<h3>{benefit.title}</h3>
								<p>{benefit.text}</p>
							</li>
						))}
					</ul>
					<p class="fee">
						<span class="fee__label">Membership fee</span>
						<span class="fee__price"><strong>{membershipFee.amount}</strong> {membershipFee.period}</span>
					</p>
				</div>
				<div class="split__media">
					<Image src={visitPhoto} alt="Students around a table during a START Berlin visit" widths={[640, 1080, 1600]} sizes="(min-width: 1344px) 510px, (min-width: 1024px) 40vw, 100vw" format="webp" loading="lazy" class="photo photo--benefits" />
				</div>
			</div>
			<ul class="stats" role="list" aria-label="START Berlin in numbers">
				{stats.map((stat) => (
					<li class="stat">
						<p class="stat__value">{stat.value}</p>
						<p class="stat__label">{stat.label}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="page-container split split--reverse" aria-labelledby="join-eligibility-heading">
			<div class="split__text">
				<SectionHeading id="join-eligibility-heading">
					Is this <span data-outline>you?</span>
					<Fragment slot="lead">We look forward to your application if:</Fragment>
				</SectionHeading>
				<ul class="checklist">
					{
						requirements.map((requirement) => (
							<li class="checklist__item">
								<span class="checklist__icon" aria-hidden="true">
									<Icon name="check" stroke-width={3} />
								</span>
								{requirement}
							</li>
						))
					}
				</ul>
			</div>
			<div class="split__media">
				<Image src={teamLiftingPhoto} alt="START Berlin members lifting a teammate and laughing" widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 40vw, 100vw" class="photo photo--landscape" />
			</div>
		</section>

		<section class="page-container" id="process" aria-labelledby="join-process-heading">
			<SectionHeading id="join-process-heading">
				Your path to <span data-outline>START Berlin</span>
			</SectionHeading>
			<ol class="steps" role="list">
				{
					steps.map((step, index) => (
						<li class="step">
							<span class="step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<h3 class="step__title">{step.title}</h3>
							{step.date && <p class="step__date">{step.date}</p>}
							<p class="step__text">{step.text}</p>
						</li>
					))
				}
			</ol>
			<p class="note">We share the interview and onboarding dates for each application round.</p>
		</section>

		<JoinTrips />

		<section class="banner" aria-labelledby="join-events-heading">
			<Image src={audiencePhoto} alt="" widths={[640, 1080, 1600, 2400]} sizes="100vw" format="webp" loading="lazy" class="banner__image" />
			<div class="banner__shade" aria-hidden="true"></div>
			<div class="banner__content page-container">
				<SectionHeading id="join-events-heading" flush>
					Meet us <span data-outline>in person</span>
					<Fragment slot="lead">
						Around every application round we host online and in-person info events. Drop by, ask your
						questions and meet current members before you apply.
					</Fragment>
				</SectionHeading>
				<div class="actions">
					<a href="/events" class="button">See upcoming events</a>
				</div>
			</div>
		</section>

		<section class="page-container" id="departments" aria-labelledby="join-departments-heading">
			<SectionHeading id="join-departments-heading">
				{departmentsSection.headingSolid}{' '}<span data-outline>{departmentsSection.headingOutline}</span>
				<Fragment slot="lead">{departmentsSection.subheading}</Fragment>
			</SectionHeading>
			<DepartmentTabs departments={departments} />
		</section>

		<MemberStories />

		<section class="page-container" id="faq" aria-labelledby="join-faq-heading">
			<SectionHeading id="join-faq-heading">
				Frequently asked <span data-outline>questions</span>
			</SectionHeading>
			<div class="faq-list">
				{
					faqs.map((faq) => (
						<details class="faq" name="faq">
							<summary class="faq__question">
								<span class="faq__question-text">{faq.question}</span>
								<Icon name="chevron-down" class="faq__icon" />
							</summary>
							<p class="faq__answer">{faq.answer}</p>
						</details>
					))
				}
			</div>
		</section>

		<section class="banner" aria-labelledby="join-contact-heading">
			<Image src={teamPhoto} alt="" widths={[640, 1080, 1600, 2400]} sizes="100vw" format="webp" loading="lazy" class="banner__image" />
			<div class="banner__shade" aria-hidden="true"></div>
			<div class="banner__content page-container">
				<SectionHeading id="join-contact-heading" flush>
					Get in <span data-outline>touch</span>
					<Fragment slot="lead">Ask us about eligibility or the application process.</Fragment>
				</SectionHeading>
				<div class="actions">
					<a href={links.contact} class="button button--outline">Contact us <Icon name="arrow-right" size={16} /></a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.banner__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.actions .button,
	.hero-action {
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}

	@media (max-width: 639.98px) {
		/* Keep the title below the shared photo spacing when the hero has no action. */
		.join-hero :global(.page-hero__foreground) { align-self: stretch; }
	}

	/* Application round */

	.round {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-8);
		padding: var(--space-card);
		border-inline-start: var(--border-width-accent) solid var(--color-accent);
		background: var(--surface-accent);
	}

	.round__heading {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--text-copy);
	}

	.round__date {
		display: block;
		font-size: var(--type-stat);
		font-weight: var(--weight-display);
		line-height: var(--leading-display);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	/* Membership benefits and figures */

	.benefits-section {
		container: join-benefits / inline-size;
	}

	.stats {
		display: grid;
		gap: var(--border-width);
		margin: var(--space-columns) 0 0;
		padding: 0;
		list-style: none;
		border: var(--border-width) solid var(--border-accent);
		border-radius: var(--radius-card);
		background: var(--border-accent);
		overflow: clip;
	}

	.stat {
		display: grid;
		align-content: center;
		min-width: 0;
		padding: var(--space-6) var(--space-card);
		background: var(--color-accent);
		color: var(--color-dark-blue);
	}

	.stat__value {
		margin: 0;
		font-size: var(--type-stat);
		font-weight: var(--weight-display);
		line-height: var(--leading-display);
		font-variant-numeric: tabular-nums;
	}

	.stat:first-child .stat__value { font-size: var(--type-member-name); }

	.stat__label {
		margin: var(--space-2) 0 0;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-ui);
	}

	@container join-benefits (min-width: 16rem) {
		.stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@container join-benefits (min-width: 42rem) {
		.stats { grid-template-columns: minmax(0, 1.45fr) repeat(3, minmax(0, 1fr)); }
	}

	@media (forced-colors: active) {
		.stat + .stat { border-block-start: var(--border-width) solid GrayText; }
	}

	/* Text + photo */

	.split {
		display: grid;
		gap: var(--space-columns);
		align-items: center;
	}

	.photo {
		width: 100%;
		height: auto;
		aspect-ratio: var(--ratio-portrait);
		object-fit: cover;
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
	}

	/* Keeps the whole group in frame; a portrait crop cuts off the person being lifted. */
	.photo--landscape,
	.photo--benefits {
		aspect-ratio: var(--ratio-photo);
	}

	.checklist {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin: 0 0 var(--space-6);
		padding: 0;
		list-style: none;
	}

	.benefits {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.benefits__item {
		padding-block: var(--space-3);
		border-block-end: var(--border-width) solid var(--border-subtle);
	}

	.benefits__item:first-child { padding-block-start: 0; }

	.benefits__item h3 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
	}

	.benefits__item p {
		margin: 0;
		line-height: var(--leading-copy);
		color: var(--text-muted);
	}

	.fee {
		display: grid;
		gap: var(--space-2);
		margin: var(--space-6) 0 0;
	}

	.fee__label {
		font-size: var(--text-caption);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.fee__price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		font-size: var(--text-base);
		line-height: var(--leading-ui);
		color: var(--text-copy);
	}

	.fee__price strong {
		font-size: var(--text-4xl);
		font-weight: var(--weight-display);
		line-height: var(--leading-display);
		color: var(--color-accent);
	}

	.checklist__item {
		display: flex;
		align-items: flex-start;
		gap: var(--space-4);
		font-size: var(--text-lead);
		line-height: var(--leading-copy);
		color: var(--text-copy);
	}

	.checklist__icon {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: var(--color-dark-blue);
	}

	.checklist__icon svg {
		width: 0.875rem;
		height: 0.875rem;
	}

	/* Steps */

	.steps {
		display: grid;
		gap: var(--space-grid);
		margin: 0 0 var(--space-8);
		padding: 0;
		list-style: none;
	}

	.step {
		position: relative;
		padding: var(--space-card);
		background: var(--surface-card);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
		transition: border-color var(--duration-ui), transform var(--duration-ui);
	}

	.step:hover {
		border-color: var(--border-accent);
		transform: translateY(-2px);
	}

	.step__number {
		display: block;
		margin-bottom: var(--space-6);
		font-size: var(--type-step-number);
		font-weight: var(--weight-display);
		line-height: var(--leading-display);
		-webkit-text-stroke: var(--border-width-accent) var(--color-accent);
		-webkit-text-fill-color: transparent;
	}

	.step__title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
		font-weight: var(--weight-display);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}

	.step__date {
		margin: 0 0 var(--space-3);
		font-size: var(--text-caption);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.step__text {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-copy);
		color: var(--text-copy);
	}

	.note {
		max-width: var(--layout-reading);
		margin: 0;
		font-size: var(--text-compact);
		line-height: var(--leading-copy);
		color: var(--text-subtle);
	}

	/* Full-bleed photo bands */

	.banner {
		position: relative;
		overflow: hidden;
	}

	.banner__shade {
		position: absolute;
		inset: 0;
		background: var(--gradient-photo-band);
	}

	.banner__content {
		position: relative;
		padding-block: var(--space-page-start);
	}

	@media (max-width: 767.98px) {
		.banner__shade {
			background: var(--gradient-photo-band), var(--surface-photo-card);
		}
	}

	/* FAQ */

	.faq-list {
		display: flex;
		flex-direction: column;
		border-top: var(--border-width) solid var(--border-subtle);
	}

	.faq {
		border-bottom: var(--border-width) solid var(--border-subtle);
	}

	.faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: var(--target-min);
		padding: var(--space-5) 0;
		cursor: pointer;
		list-style: none;
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
		color: var(--text-primary);
	}

	/* Remove the default marker in WebKit / Blink. */
	.faq__question::-webkit-details-marker { display: none; }
	.faq__question::marker { content: ''; }

	.faq__question-text {
		min-width: 0;
	}

	.faq__icon {
		flex-shrink: 0;
		width: 1.25rem;
		height: 1.25rem;
		color: var(--text-muted);
		transition: transform var(--duration-ui), color var(--duration-ui);
	}

	.faq[open] .faq__icon {
		transform: rotate(180deg);
		color: var(--color-accent);
	}

	.faq__question:hover { color: var(--color-accent); }
	.faq__question:hover .faq__icon { color: var(--color-accent); }

	.faq__answer {
		margin: 0 0 var(--space-5);
		max-width: var(--layout-reading);
		font-size: var(--text-compact);
		line-height: var(--leading-copy);
		color: var(--text-muted);
	}

	@media (min-width: 1024px) {
		.split {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}

		.split--reverse {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		}

		.split--reverse .split__media {
			order: -1;
		}

		.steps {
			grid-template-columns: repeat(3, 1fr);
		}

		.photo--benefits { aspect-ratio: var(--ratio-square); }
	}

	@media (prefers-reduced-motion: reduce) {
		.faq__icon { transition: none; }
	}

</style>
