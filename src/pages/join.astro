---
import Icon from '../components/icons/Icon.astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DepartmentTabs from '../components/member-journey/DepartmentTabs.astro';
import MemberStories from '../components/MemberStories.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import groupPhoto from '../assets/hero/hero-1.jpg';
import teamPhoto from '../assets/hero/hero-3.jpg';
import audiencePhoto from '../assets/hero/hero-4.jpg';
import teamFourPhoto from '../assets/join/team-four.jpg';
import teamLiftingPhoto from '../assets/join/team-lifting.jpg';
import { pageSeo } from '../lib/seo/pages';
import { departments, departmentsSection, membershipFee } from '../data/member-journey';

// Flip when a round opens: swaps the status pill and points the main CTA at the
// application form instead of the talent pool.
const applicationsOpen = false;

const links = {
	apply: 'https://forms.start-berlin.com/apply',
	talentPool: 'https://forms.start-berlin.com/talent-pool',
	contact: 'https://forms.start-berlin.com/contact',
};

const primaryCta = applicationsOpen
	? { label: 'Apply now', href: links.apply }
	: { label: 'Join the talent pool', href: links.talentPool };

const stats = [
	{ value: '500+', label: 'Alumni' },
	{ value: '54', label: 'Active Members' },
	{ value: '15+', label: 'Nationalities' },
	{ value: '5', label: 'Departments' },
];

const benefits = [
	'A network of talented members and potential co-founders',
	'Direct contact with, and insights into, the most successful startups in Berlin',
	'Contact to investors, mentors, startups and industry experts',
	'Workshops with industry experts on topics such as legal, sales and entrepreneurship',
	'Access to the international START network with partners across Europe and Latin America',
	'An extensive network of START Berlin partners and alumni',
];

const requirements = [
	'You are enrolled at a university',
	'You have a burning passion for entrepreneurship',
	'You want to become a founder, get into venture capital, meet prospective co-founders or learn more about the ecosystem',
	'You commit to being an active member of our community for one entire year',
	'You are based in Berlin for at least the next 6 months',
];

// Add a `date` to each step once the next round's timeline is fixed.
const steps: { title: string; text: string; date?: string }[] = [
	{
		title: 'Apply',
		text: 'Complete a short application questionnaire and upload your CV. You will receive an email confirming that we have received your application.',
	},
	{
		title: 'Interview',
		text: 'After an initial screening of the written applications, selected candidates are invited to a short interview with START members.',
	},
	{
		title: 'Onboarding',
		text: 'Your first event as an official STARTie. You meet the whole team and get to know each other. Onboarding is mandatory for new members.',
	},
];

const faqs: { question: string; answer: string }[] = [
	{
		question: 'Do I need to have a startup idea to apply?',
		answer: 'No. Many of our members join without a specific idea. START Berlin is about exploring the entrepreneurship ecosystem, meeting potential co-founders and learning how to build — whether you already have an idea or are still looking for one.',
	},
	{
		question: 'Which universities can I apply from?',
		answer: 'You can apply from any university or higher education institution in Berlin or Potsdam. We welcome students from all academic backgrounds.',
	},
	{
		question: 'How much time do I need to commit?',
		answer: 'Members commit for one full year and contribute to one of our five departments. The exact time varies by role and department, but expect to invest a few hours per week alongside regular events and meetings.',
	},
	{
		question: 'What is the membership fee?',
		answer: `The annual membership fee is ${membershipFee}. This helps keep the organisation financially sustainable and covers event costs, tools and community activities.`,
	},
	{
		question: 'When do applications open?',
		answer: 'We recruit new members twice a year, typically in April and October. The next application round opens in April 2027. Subscribe to our newsletter to get notified as soon as applications open.',
	},
	{
		question: 'Can I apply if I am an exchange student?',
		answer: 'Yes, as long as you are based in Berlin for at least six months and can commit to being an active member for one full year. We have members from many countries and backgrounds.',
	},
	{
		question: 'What happens after I apply?',
		answer: 'After submitting your application, you will receive a confirmation email. Selected candidates are invited to a short interview with current START Berlin members. Successful applicants then join the mandatory onboarding event.',
	},
];

---

<Layout seo={pageSeo('/join')}>
	<PageHero title={['How to join', 'START Berlin']} image={groupPhoto} alt="START Berlin members posing together for a group photo.">
		<p slot="status" class:list={['status', { 'status--open': applicationsOpen, 'status--closed': !applicationsOpen }]}>
			<span class="status__dot"></span>
			{applicationsOpen ? 'Applications are open' : 'Applications are closed'}
		</p>
		<Fragment slot="description">Become part of Berlin's student entrepreneurship network.</Fragment>
		<div slot="actions" class="actions actions--hero">
			<a href={primaryCta.href} class="button">{primaryCta.label}</a>
			<a href="#process" class="button button--outline">See the process</a>
		</div>
	</PageHero>

	{!applicationsOpen && (
		<div class="closed-banner page-container">
			<div class="closed-card">
				<span class="closed-card__dot" aria-hidden="true"></span>
				<div class="closed-card__content">
					<h2 class="closed-card__title">Applications are currently closed</h2>
					<p class="closed-card__text">
						The next application round opens in <strong>April 2027</strong>. Subscribe to our newsletter
						or join the talent pool to be the first to know when applications open.
					</p>
					<div class="closed-card__actions">
						<a href="#newsletter" class="button">Subscribe to newsletter</a>
						<a href={links.talentPool} class="button button--outline">Join the talent pool</a>
					</div>
				</div>
			</div>
		</div>
	)}

	<div class="stats page-container">
		{
			stats.map((stat) => (
				<div class="stat">
					<p class="stat__value">{stat.value}</p>
					<p class="stat__label">{stat.label}</p>
				</div>
			))
		}
	</div>

	<div class="section-stack page-flow">
		<section class="page-container split" aria-labelledby="join-benefits-heading">
			<div class="split__text">
				<SectionHeading id="join-benefits-heading" eyebrow="Why you should apply">
					Dive into Berlin's <span data-outline>startup ecosystem</span>
					<Fragment slot="lead">
						Whether you're just starting out or looking to take your venture to the next level, at START
						Berlin you dive deep into a vibrant ecosystem of innovation, collaboration and growth. Explore
						our network, connect with industry experts and learn from peers to sharpen your skills and bring
						your ideas to life.
					</Fragment>
				</SectionHeading>
				<ul class="benefits">
					{
						benefits.map((benefit) => (
							<li class="benefits__item">
								<Icon name="chevron-right" />
								{benefit}
							</li>
						))
					}
				</ul>
				<p class="fee">
					To provide these benefits and keep the organisation financially sustainable, active members pay
					a membership fee of <strong>{membershipFee}</strong>.
				</p>
			</div>
			<div class="split__media">
				<Image src={teamFourPhoto} alt="Four START Berlin members in team shirts" widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 40vw, 100vw" class="photo" />
			</div>
		</section>

		<section class="page-container split split--reverse" aria-labelledby="join-eligibility-heading">
			<div class="split__text">
				<SectionHeading id="join-eligibility-heading" eyebrow="Who we are looking for">
					Is this <span data-outline>you?</span>
					<Fragment slot="lead">We look forward to your application if:</Fragment>
				</SectionHeading>
				<ul class="checklist">
					{
						requirements.map((requirement) => (
							<li class="checklist__item">
								<span class="checklist__icon" aria-hidden="true">
									<Icon name="check" stroke-width={3} />
								</span>
								{requirement}
							</li>
						))
					}
				</ul>
			</div>
			<div class="split__media">
				<Image src={teamLiftingPhoto} alt="START Berlin members lifting a teammate and laughing" widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 40vw, 100vw" class="photo photo--landscape" />
			</div>
		</section>

		<section class="page-container" id="process" aria-labelledby="join-process-heading">
			<SectionHeading id="join-process-heading" eyebrow="Application process">
				Your path to <span data-outline>START Berlin</span>
			</SectionHeading>
			<ol class="steps" role="list">
				{
					steps.map((step, index) => (
						<li class="step">
							<span class="step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<h3 class="step__title">{step.title}</h3>
							{step.date && <p class="step__date">{step.date}</p>}
							<p class="step__text">{step.text}</p>
						</li>
					))
				}
			</ol>
			<p class="note">
				We share the dates for interviews and onboarding with each application round. Please block the
				onboarding in your calendar as soon as you know it, and we strongly encourage you to join the
				network trip as well.
			</p>
		</section>

		<section class="banner" aria-labelledby="join-events-heading">
			<Image src={audiencePhoto} alt="" widths={[640, 1080, 1600, 2400]} sizes="100vw" class="banner__image" />
			<div class="banner__shade"></div>
			<div class="banner__content page-container">
				<SectionHeading id="join-events-heading" eyebrow="Want to get to know us?" flush>
					Meet us <span data-outline>in person</span>
					<Fragment slot="lead">
						Around every application round we host online and in-person info events. Drop by, ask your
						questions and meet current members before you apply.
					</Fragment>
				</SectionHeading>
				<div class="actions">
					<a href="/events" class="button">See upcoming events</a>
				</div>
			</div>
		</section>

		<section class="page-container" id="departments" aria-labelledby="join-departments-heading">
			<SectionHeading id="join-departments-heading">
				{departmentsSection.headingSolid}{' '}<span data-outline>{departmentsSection.headingOutline}</span>
				<Fragment slot="lead">{departmentsSection.subheading}</Fragment>
			</SectionHeading>
			<DepartmentTabs departments={departments} />
		</section>

		<NewsletterSignup />
		<MemberStories />

		<section class="page-container" id="faq" aria-labelledby="join-faq-heading">
			<SectionHeading id="join-faq-heading" eyebrow="Have questions?">
				Frequently asked <span data-outline>questions</span>
			</SectionHeading>
			<div class="faq-list">
				{
					faqs.map((faq) => (
						<details class="faq" name="faq">
							<summary class="faq__question">
								<span class="faq__question-text">{faq.question}</span>
								<Icon name="chevron-down" class="faq__icon" />
							</summary>
							<p class="faq__answer">{faq.answer}</p>
						</details>
					))
				}
			</div>
		</section>

		<div class="closing">
			<Image src={teamPhoto} alt="" widths={[640, 1080, 1600, 2400]} sizes="100vw" class="closing__image" />
			<div class="closing__shade"></div>
			<div class="closing__grid page-container">
				<div class="closing__card">
					<SectionHeading id="join-talent-pool-heading" eyebrow="Stay up to date" compact flush>
						Join our talent pool
					</SectionHeading>
					<p class="closing__text">
						Get a reminder when applications open again, hear about upcoming events and stay up to date
						with START Berlin.
					</p>
					<a href={links.talentPool} class="button">Sign up</a>
				</div>
				<div class="closing__card">
					<SectionHeading id="join-contact-heading" eyebrow="Any questions left?" compact flush>
						Get in touch
					</SectionHeading>
					<p class="closing__text">
						Unsure about the application process, your eligibility or what START Berlin is all about?
						Just reach out.
					</p>
					<a href={links.contact} class="button button--outline">Contact us</a>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	.banner__image,
	.closing__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Closed applications banner */

	.closed-banner {
		margin-top: var(--space-page-start);
	}

	.closed-card {
		position: relative;
		display: flex;
		gap: var(--space-4);
		padding: var(--space-card);
		background: var(--surface-card);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
	}

	.closed-card__dot {
		flex-shrink: 0;
		width: 0.625rem;
		height: 0.625rem;
		margin-top: var(--space-2);
		border-radius: var(--radius-pill);
		background: var(--color-error);
	}

	.closed-card__content {
		min-width: 0;
	}

	.closed-card__title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
		color: var(--color-white);
	}

	.closed-card__text {
		margin: 0;
		font-size: var(--text-compact);
		line-height: var(--leading-copy);
		color: var(--text-copy);
	}

	.closed-card__text strong {
		color: var(--color-white);
	}

	.closed-card__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.closed-card__actions .button {
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}

	/* Status pill */

	.status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0 0 var(--space-6);
		padding: var(--space-1) var(--space-4);
		border: var(--border-width) solid var(--border-strong);
		border-radius: var(--radius-pill);
		background: var(--surface-status);
		backdrop-filter: blur(var(--blur-status));
		font-size: var(--text-xs);
		line-height: var(--leading-ui);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--text-copy);
	}

	.status__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: var(--radius-pill);
		background: var(--border-control);
	}

	.status--open {
		border-color: var(--border-accent);
		color: var(--color-accent);
	}

	.status--open .status__dot {
		background: var(--color-accent);
		box-shadow: var(--ring-status);
	}

	.status--closed .status__dot {
		background: var(--color-error);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.actions .button, .closing__card .button {
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}

	/* Stats - Number Cards */

	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-grid);
		margin-top: var(--space-page-start);
		padding: 0;
	}

	.stat {
		min-width: 0;
		padding: var(--space-6) var(--space-4);
		text-align: center;
		background: var(--surface-card);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
		transition: border-color var(--duration-ui);
	}

	.stat:hover {
		border-color: var(--border-accent);
	}

	.stat__value {
		margin: 0;
		font-size: var(--type-stat);
		font-weight: var(--weight-display);
		line-height: var(--leading-display);
		font-variant-numeric: tabular-nums;
		color: var(--color-accent);
	}

	.stat__label {
		margin: var(--space-2) 0 0;
		font-size: var(--text-xs);
		line-height: var(--leading-ui);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	/* Text + photo */

	.split {
		display: grid;
		gap: var(--space-columns);
		align-items: center;
	}

	.photo {
		width: 100%;
		height: auto;
		aspect-ratio: var(--ratio-portrait);
		object-fit: cover;
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
	}

	/* Keeps the whole group in frame; a portrait crop cuts off the person being lifted. */
	.photo--landscape {
		aspect-ratio: var(--ratio-photo);
	}

	.benefits,
	.checklist {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin: 0 0 var(--space-6);
		padding: 0;
		list-style: none;
	}

	.benefits__item {
		display: flex;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-card);
		background: var(--surface-card);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-field);
		font-size: var(--text-base);
		line-height: var(--leading-copy);
		color: var(--text-copy);
		transition: border-color var(--duration-ui);
	}

	.benefits__item:hover {
		border-color: var(--border-accent);
	}

	.benefits__item svg {
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		margin-top: var(--space-1);
		color: var(--color-accent);
	}

	.fee {
		margin: 0;
		padding-left: var(--space-4);
		border-left: var(--border-width-accent) solid var(--color-accent);
		font-size: var(--text-compact);
		line-height: var(--leading-copy);
		color: var(--text-muted);
	}

	.fee strong {
		color: var(--color-white);
	}

	.checklist__item {
		display: flex;
		align-items: flex-start;
		gap: var(--space-4);
		font-size: var(--text-lead);
		line-height: var(--leading-copy);
		color: var(--text-copy);
	}

	.checklist__icon {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: var(--color-dark-blue);
	}

	.checklist__icon svg {
		width: 0.875rem;
		height: 0.875rem;
	}

	/* Steps */

	.steps {
		display: grid;
		gap: var(--space-grid);
		margin: 0 0 var(--space-8);
		padding: 0;
		list-style: none;
	}

	.step {
		position: relative;
		padding: var(--space-card);
		background: var(--surface-card);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
		transition: border-color var(--duration-ui), transform var(--duration-ui);
	}

	.step:hover {
		border-color: var(--border-accent);
		transform: translateY(-2px);
	}

	.step__number {
		display: block;
		margin-bottom: var(--space-6);
		font-size: var(--type-step-number);
		font-weight: var(--weight-display);
		line-height: var(--leading-display);
		-webkit-text-stroke: var(--border-width-accent) var(--color-accent);
		-webkit-text-fill-color: transparent;
	}

	.step__title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
		font-weight: var(--weight-display);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}

	.step__date {
		margin: 0 0 var(--space-3);
		font-size: var(--text-caption);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.step__text {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-copy);
		color: var(--text-copy);
	}

	.note {
		max-width: var(--layout-reading);
		margin: 0;
		font-size: var(--text-compact);
		line-height: var(--leading-copy);
		color: var(--text-subtle);
	}

	/* Full-bleed photo bands */

	.banner,
	.closing {
		position: relative;
		overflow: hidden;
	}

	.banner__shade {
		position: absolute;
		inset: 0;
		background: var(--gradient-photo-band);
	}

	.banner__content {
		position: relative;
		padding-block: var(--space-page-start);
	}

	/* FAQ */

	.faq-list {
		display: flex;
		flex-direction: column;
		border-top: var(--border-width) solid var(--border-subtle);
	}

	.faq {
		border-bottom: var(--border-width) solid var(--border-subtle);
	}

	.faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: var(--target-min);
		padding: var(--space-5) 0;
		cursor: pointer;
		list-style: none;
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
		color: var(--text-primary);
	}

	/* Remove the default marker in WebKit / Blink. */
	.faq__question::-webkit-details-marker { display: none; }
	.faq__question::marker { content: ''; }

	.faq__question-text {
		min-width: 0;
	}

	.faq__icon {
		flex-shrink: 0;
		width: 1.25rem;
		height: 1.25rem;
		color: var(--text-muted);
		transition: transform var(--duration-ui), color var(--duration-ui);
	}

	.faq[open] .faq__icon {
		transform: rotate(180deg);
		color: var(--color-accent);
	}

	.faq__question:hover { color: var(--color-accent); }
	.faq__question:hover .faq__icon { color: var(--color-accent); }

	.faq__answer {
		margin: 0 0 var(--space-5);
		max-width: var(--layout-reading);
		font-size: var(--text-compact);
		line-height: var(--leading-copy);
		color: var(--text-muted);
	}

	/* Closing CTAs */

	.closing__shade {
		position: absolute;
		inset: 0;
		background: var(--surface-photo-shade);
	}

	.closing__grid {
		position: relative;
		display: grid;
		gap: var(--space-grid);
		padding-block: var(--space-page-start);
	}

	.closing__card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		padding: var(--space-card);
		background: var(--surface-photo-card);
		backdrop-filter: blur(var(--blur-sticky));
		border: var(--border-width) solid var(--border-default);
		border-radius: var(--radius-card);
	}

	.closing__text {
		flex-grow: 1;
