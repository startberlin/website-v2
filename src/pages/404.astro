---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import teamPhoto from '../assets/hero/hero-404.jpg';
import { pageSeo } from '../lib/seo/pages';

Astro.response.status = 404;

/**
 * Show the requested path in a human-readable way.
 * Decode percent-encoded characters and strip trailing slashes.
 * Never reflect raw query strings or fragments back into HTML –
 * Astro's text interpolation handles escaping, but keep the value short
 * and limited to the pathname so it stays useful without risk.
 */
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const displayPath = decodeURIComponent(rawPath);
---

<Layout seo={pageSeo('/404')}>
	<PageHero
		title={['Surprise, surprise…', 'nothing to see here']}		title={['Surprise, surprise…', 'nothing to see here']}
		image={teamPhoto}
		imagePosition="50% 35%"
		mobileImagePosition="50% 30%"
		compactTitle
	>
		<Fragment slot="actions">
			<div class="error-actions">
				<a class="button" href="/">Back to home</a>
				<a class="button button--outline" href="/jobs">Browse jobs</a>
			</div>
		</Fragment>
	</PageHero>

	<div class="page-container">
		<p class="error-guidance readable">
			If you typed the address, check it for typos. You can also{' '}
			<a href="#error-recovery">browse the current pages</a> for events and membership information.
		</p>
	</div>

	<nav class="page-container page-flow" aria-labelledby="error-recovery">
		<SectionHeading id="error-recovery" compact>Explore START Berlin</SectionHeading>
		<ul class="error-links" role="list">
			<li><a class="text-action" href="/events">Events</a></li>
			<li><a class="text-action" href="/members">Our Members</a></li>
			<li><a class="text-action" href="/member-journey">Member Journey</a></li>
			<li><a class="text-action" href="/join">Apply Now</a></li>
		</ul>
	</nav>
</Layout>

<style>
	.error-path {
		display: inline-block;
		max-width: 100%;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-control);
		background: var(--surface-control);
		border: var(--border-width) solid var(--border-subtle);
		font-size: var(--text-sm);
		word-break: break-all;
		overflow-wrap: anywhere;
		vertical-align: baseline;
	}

	.error-recovery {
		padding-block-end: var(--space-section);
	}

	.error-recovery__heading {
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		line-height: var(--leading-ui);
	}

	.error-recovery__text {
		max-width: var(--layout-reading);
		margin: var(--space-4) 0 0;
		color: var(--text-copy);
		font-size: var(--text-base);
		line-height: var(--leading-copy);
	}

	.error-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-block-start: var(--space-6);
	}

	.error-guidance {
		margin: 0;
		padding-block-start: var(--space-page-start);
		color: var(--text-copy);
		line-height: var(--leading-copy);
	}

	.error-guidance a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.error-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
