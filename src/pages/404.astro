---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import eventAudience from '../assets/hero/hero-4.jpg';
import { pageSeo } from '../lib/seo/pages';

Astro.response.status = 404;
---

<Layout seo={pageSeo('/404')}>
  <PageHero title={['Page', 'not found']} image={eventAudience} imagePosition="50% 45%" mobileImagePosition="68% 50%">
    <Fragment slot="actions">
      <div class="error-actions">
        <a class="button" href="/">Back to home</a>
        <a class="button button--outline" href="/jobs">Browse jobs</a>
      </div>
    </Fragment>
  </PageHero>
</Layout>

<style>
  .error-actions { display: flex; flex-wrap: wrap; gap: var(--space-4); }
</style>
