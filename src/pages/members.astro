---
import Icon from '../components/icons/Icon.astro';
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import PageHero from '../components/PageHero.astro';
import teamPhoto from '../assets/hero/hero-3.jpg';
import type { ImageMetadata } from 'astro';
import { memberProfiles } from '../lib/member-profiles';
import { boardGroups, boardProfilePath, type TeamSeason } from '../lib/board-members';
// Maintained Cockpit roster snapshot. Season roles stay separate from the
// shared portraits and public profile links.
import team from '../data/team.json';
import { pageSeo } from '../lib/seo/pages';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/members/*.webp', { eager: true });
const profileFor = (name: string) => {
	const profile = memberProfiles[name];
	const portrait = profile?.portrait ? portraits[`../assets/members/${profile.portrait}`]?.default : undefined;
	if (profile?.portrait && !portrait) throw new Error(`Missing portrait for ${name}`);
	return { linkedin: profile?.linkedin, email: profile?.email, portrait };
};

const slugify = (value: string) =>
	value
		.toLowerCase()
		.replace(/&/g, 'and')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');

const seasons = (team.seasons as TeamSeason[]).map((season) => {
	const boardRows = boardGroups(season);
	const sections = [
		{
			id: 'board',
			name: 'Board',
			members: boardRows.flat(),
			rows: boardRows,
		},
		...season.departments.map((department) => ({
			id: slugify(department.name),
			name: department.name,
			members: department.members,
			rows: [department.members],
		})),
	];
	const people = new Set(sections.flatMap((section) => section.members.map((member) => member.name)));
	return { id: slugify(season.label), label: season.label, sections, count: people.size };
});

// Every department that appears in any season, in first-seen order.
const departments = [
	...new Map(seasons.flatMap((season) => season.sections.map((section) => [section.id, section.name]))),
];
---

<Layout seo={pageSeo('/members')}>
	<PageHero image={teamPhoto} alt="START Berlin team posing together in START shirts." imagePosition="50% 10%" mobileImagePosition="58% 35%">
		<Fragment slot="title"><span data-hero-line>Meet the</span> <span data-hero-line data-hero-accent>team</span></Fragment>
		<Fragment slot="description">The people behind START Berlin. Get to know our board and departments.</Fragment>
	</PageHero>

	<div class="filters">
		<div class="filters__inner page-container">
			<label class="search">
				<span class="visually-hidden">Search members</span>
				<Icon name="search" />
				<input type="search" name="member-search" placeholder="Search by name or role" autocomplete="off" data-member-search />
			</label>

			<div class="timeline" role="tablist" aria-label="Season">
				{
					seasons.map((season, index) => (
						<button
							class="timeline__season"
							role="tab"
							aria-selected={index === 0 ? 'true' : 'false'}
							aria-controls={`season-${season.id}`}
							id={`tab-${season.id}`}
							tabindex={index === 0 ? 0 : -1}
							data-season-tab={season.id}
						>
							{season.label}
						</button>
					))
				}
			</div>

			<label class="select">
				<span class="visually-hidden">Filter by department</span>
				<select data-member-department>
					<option value="">All departments</option>
					{departments.map(([id, name]) => <option value={id}>{name}</option>)}
				</select>
				<Icon name="chevron-down" />
			</label>
		</div>
	</div>

	<div class="groups page-container">
		<p class="directory-count" aria-live="polite" aria-atomic="true">
			<span data-member-count>{seasons[0].count}</span> <span data-member-count-label>members</span><span data-member-count-filter hidden> matching your filters</span>
		</p>
		{
			seasons.map((season, index) => (
				<div
					class="season"
					id={`season-${season.id}`}
					role="tabpanel"
					aria-labelledby={`tab-${season.id}`}
					data-season={season.id}
					data-count={season.count}
					hidden={index > 0}
				>
					{season.sections.map((section) => (
						<section class="group" id={`${season.id}-${section.id}`} data-member-group={section.id}>
							<h2 class="group__label">{section.name}</h2>
							<div class="group__rows">
								{section.rows.map((row) => (
									<div class="group__grid" data-board-row={section.id === 'board' ? '' : undefined}>
										{row.map((member) => (
											<MemberCard name={member.name} role={member.role} batch={member.batch} group={section.name} profileUrl={boardProfilePath(member.name)} {...profileFor(member.name)} />
										))}
									</div>
								))}
							</div>
						</section>
					))}
				</div>
			))
		}

		<p class="empty" role="status" aria-live="polite" data-member-empty hidden>No members match your search.</p>
	</div>
</Layout>

<script>
	const search = document.querySelector<HTMLInputElement>('[data-member-search]')!;
	const department = document.querySelector<HTMLSelectElement>('[data-member-department]')!;
	const tabs = document.querySelectorAll<HTMLElement>('[data-season-tab]');
	const panels = document.querySelectorAll<HTMLElement>('[data-season]');
	const count = document.querySelector<HTMLElement>('[data-member-count]')!;
	const countLabel = document.querySelector<HTMLElement>('[data-member-count-label]')!;
	const countFilter = document.querySelector<HTMLElement>('[data-member-count-filter]')!;
	const empty = document.querySelector<HTMLElement>('[data-member-empty]')!;
	const filters = document.querySelector<HTMLElement>('.filters')!;
	// Follow the actual filter height when text size or orientation changes.
	const syncFilterHeight = () => {
		const height = getComputedStyle(filters).position === 'sticky' ? filters.getBoundingClientRect().height : 0;
		document.documentElement.style.setProperty('--member-filter-height', `${height}px`);
	};
	new ResizeObserver(syncFilterHeight).observe(filters);
	window.addEventListener('resize', syncFilterHeight);
	syncFilterHeight();

	const showSeason = (id: string) => {
		const panel = [...panels].find((candidate) => candidate.dataset.season === id);
		if (!panel) return;

		panels.forEach((candidate) => (candidate.hidden = candidate !== panel));
		tabs.forEach((tab) => {
			const selected = tab.dataset.seasonTab === id;
			tab.setAttribute('aria-selected', String(selected));
			tab.tabIndex = selected ? 0 : -1;
		});
		applyFilters();
	};

	const applyFilters = () => {
		const panel = [...panels].find((candidate) => !candidate.hidden)!;
		const query = search.value.trim().toLowerCase();
		const visibleNames = new Set<string>();
		let anyVisible = false;

		panel.querySelectorAll<HTMLElement>('[data-member-group]').forEach((group) => {
			const groupSelected = !department.value || department.value === group.dataset.memberGroup;
			let groupVisible = false;

			group.querySelectorAll<HTMLElement>('[data-member]').forEach((card) => {
				const match = groupSelected && card.dataset.search!.includes(query);
				card.hidden = !match;
				if (match) visibleNames.add(card.querySelector<HTMLHeadingElement>('.card__name')!.textContent!.trim());
				groupVisible ||= match;
			});
			group.querySelectorAll<HTMLElement>('[data-board-row]').forEach((row) => {
				row.hidden = ![...row.querySelectorAll<HTMLElement>('[data-member]')].some((card) => !card.hidden);
			});

			group.hidden = !groupVisible;
			anyVisible ||= groupVisible;
		});

		empty.hidden = anyVisible;
		count.textContent = String(visibleNames.size);
		countLabel.textContent = visibleNames.size === 1 ? 'member' : 'members';
		countFilter.hidden = !query && !department.value;
	};

	tabs.forEach((tab) =>
		tab.addEventListener('click', () => {
			const id = tab.dataset.seasonTab!;
			showSeason(id);
			// Keeps the season in the URL so a link opens the same team.
			const url = new URL(location.href);
			if (id === tabs[0].dataset.seasonTab) url.searchParams.delete('season');
			else url.searchParams.set('season', id);
			history.replaceState(null, '', url);
		}),
	);
	search.addEventListener('input', applyFilters);
	department.addEventListener('change', applyFilters);

	// Also covers field values the browser restores on reload without firing input events.
	const initialSeason = new URLSearchParams(location.search).get('season');
	showSeason([...panels].some((panel) => panel.dataset.season === initialSeason) ? initialSeason! : tabs[0].dataset.seasonTab!);
</script>

<style>
	/* Keep focused card links below the sticky navigation and filters. */
	:global(html) {
		--member-filter-height: calc(3 * var(--target-min) + 2 * var(--space-3) + 2 * var(--space-4) + 2 * var(--space-1) + 4 * var(--border-width));
		scroll-padding-block-start: calc(var(--header-height) + var(--member-filter-height) + var(--space-4));
	}

	.directory-count { margin: 0 0 var(--space-8); color: var(--text-subtle); font-size: var(--text-compact); line-height: 1.5rem; }
	.directory-count [data-member-count] { color: var(--color-white); font-weight: var(--weight-bold); }

	.filters {
		container-type: inline-size;
		container-name: member-filters;
		position: sticky;
		top: var(--header-height);
		z-index: var(--z-filters);
		background: var(--surface-sticky);
		backdrop-filter: blur(12px);
		border-block: var(--border-width) solid var(--border-subtle);
	}

	.filters__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-block: var(--space-4);
	}

	.search,
	.select {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search {
		flex-grow: 1;
		min-width: 0;
	}

	.search svg,
	.select svg {
		position: absolute;
		width: 1rem;
		height: 1rem;
		color: var(--text-subtle);
		pointer-events: none;
	}

	.search svg {
		left: 0.875rem;
	}

	.select svg {
		right: 0.875rem;
	}

	.search input,
	.select select {
		height: var(--target-min);
	}

	.search input {
		padding: 0 var(--space-4) 0 var(--space-10);
	}

	.select select {
		padding: 0 var(--space-10) 0 var(--space-4);
		appearance: none;
		cursor: pointer;
	}

	.select option {
		background: var(--color-dark-blue);
	}

	.search input:focus,
	.select select:focus {
		border-color: var(--color-accent);
	}

	.search input:focus-visible,
	.select select:focus-visible,
	.timeline__season:focus-visible {
		outline: var(--focus-width) solid var(--color-accent);
		outline-offset: var(--focus-offset);
	}

	.timeline {
		display: flex;
		flex-shrink: 0;
		align-self: flex-start;
		gap: var(--space-1);
		max-width: 100%;
		padding: var(--space-1);
		overflow-x: auto;
		background: var(--surface-control);
		border: var(--border-width) solid var(--border-default);
		border-radius: var(--radius-field);
		scrollbar-width: none;
	}

	.timeline__season {
		flex-shrink: 0;
		padding: 0 0.875rem;
		min-height: var(--target-min);
		border-radius: var(--radius-control);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		color: var(--text-subtle);
		transition: background-color var(--duration-fast), color var(--duration-fast);
	}

	.timeline__season:hover {
		color: var(--color-white);
	}

	.timeline__season[aria-selected='true'] {
		background: var(--color-accent);
		color: var(--color-dark-blue);
	}

	.groups {
		padding-block: var(--space-12) var(--space-24);
	}

	.season {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
	}

	/* Centered label between two hairlines. */
	.group__label {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		margin: 0 0 var(--space-8);
		font-size: var(--text-sm);
		line-height: 1.25rem;
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--text-subtle);
		text-align: center;
		overflow-wrap: anywhere;
	}

	.group__label::before,
	.group__label::after {
		content: '';
		flex-grow: 1;
		border-top: var(--border-width) solid var(--border-subtle);
	}

	.group__rows {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	/* Separate board rows keep the three leadership roles above the department heads. */
	.group__grid {
		--columns: 2;
		--gap: var(--space-3);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--gap);
	}

	.group__grid > :global(*) {
		flex: 0 0 calc((100% - (var(--columns) - 1) * var(--gap)) / var(--columns));
		/* Reduce the column count when enlarged text needs wider cards. */
		min-width: min(100%, 8rem);
	}

	.empty {
		margin: 0;
		padding-block: var(--space-16);
		text-align: center;
		color: var(--text-subtle);
	}

	@container member-filters (min-width: 40rem) {
		.filters__inner {
			flex-direction: row;
		}

		.select {
			flex-shrink: 0;
			width: 15rem;
		}
	}

	@media (min-width: 640px) {
		.group__grid {
			--columns: 3;
			--gap: var(--space-4);
		}
	}

	@media (min-width: 1024px) {
		.group__grid {
			--columns: 5;
			--gap: var(--space-5);
		}
	}

	/* Leave the content reachable in landscape and other short viewports. */
	@media (max-height: 600px) {
		.filters { position: static; }
		:global(html) { --member-filter-height: 0px; }
	}

</style>
