---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './icons/Icon.astro';

// Every file in src/assets/partners is shown; add a name here when the
// filename doesn't read well as alt text.
const names: Record<string, string> = {
	'bits-and-pretzels': 'Bits & Pretzels',
	'code-university': 'CODE University of Applied Sciences',
	ewor: 'EWOR',
	ey: 'EY',
	'fomo-berlin': 'FOMO Berlin',
	'humboldt-university': 'Humboldt-Universität zu Berlin',
	koro: 'KoRo',
	lanch: 'LANCH',
	lexmea: 'LexMea',
	sap: 'SAP',
	'university-of-st-gallen': 'Universität St.Gallen',
};

// Optical size corrections in px (default 48): compact square marks need more
// height to read at the same weight as wide wordmarks, heavy ones less.
const heights: Record<string, number> = {
	earlybird: 36,
	'humboldt-university': 60,
	lakestar: 60,
};

const partners = Object.entries(
	import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.{svg,png,jpg,jpeg,webp}', {
		eager: true,
	}),
)
	.map(([path, module]) => {
		const slug = path.split('/').pop()!.replace(/\.\w+$/, '');
		const fallback = slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
		return { name: names[slug] ?? fallback, logo: module.default, height: heights[slug] ?? 48 };
	})
	.sort((a, b) => a.name.localeCompare(b.name));

// Alternate partners between the two rows so both stay roughly the same length.
const rows = [
	partners.filter((_, index) => index % 2 === 0),
	partners.filter((_, index) => index % 2 === 1),
];
---

<div class="partners-wrap">
	<a href="/partners" class="partners" aria-label="See START Berlin partners">
		<div class="partners__rows">
			{
				rows.map((row, rowIndex) => (
					<div class="partners__row">
						<div
							class:list={['partners__track', { 'partners__track--reverse': rowIndex === 1 }]}
							style={`--duration: ${row.length * 3.75}s`}
						>
							{[...row, ...row].map((partner, index) => (
								<div class="partners__logo" aria-hidden={index >= row.length ? 'true' : undefined}>
									<Image
										src={partner.logo}
										alt={index < row.length ? partner.name : ''}
										height={partner.height * 2}
										style={`height: ${partner.height}px`}
									/>
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>
	</a>
	<div class="partners__actions page-container">
		<a href="#get-in-touch" class="button button--outline">Partner with us</a>
		<a href="#for-partners" class="text-action">
			<span>Explore partnerships</span>
			<Icon name="arrow-right" />
		</a>
	</div>
</div>

<style>
	.partners-wrap {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.partners__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-4) var(--space-8);
	}

	.partners__actions .button {
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}

	.partners {
		display: block;
		overflow: hidden;
	}

	.partners:focus-visible { outline-offset: calc(-1 * var(--focus-offset)); }

	.partners__rows {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.partners__track {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-4) var(--space-8);
		padding-inline: var(--page-gutter);
	}

	.partners__logo {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 60px;
		opacity: 0.8;
		transition: opacity var(--duration-ui), transform var(--duration-ui);
	}

	.partners__logo:hover {
		opacity: 1;
		transform: translateY(-1px);
	}

	.partners__logo img {
		width: auto;
		max-width: 200px;
		object-fit: contain;
		/* Render every logo as a white silhouette. */
		filter: brightness(0) invert(1);
	}

	.partners__logo[aria-hidden='true'] { display: none; }

	@media (prefers-reduced-motion: no-preference) {
		:global(html[data-motion='running']) .partners__rows::before,
		:global(html[data-motion='running']) .partners__rows::after {
			content: '';
			position: absolute;
			inset-block: 0;
			z-index: var(--z-decoration);
			width: 8rem;
			pointer-events: none;
		}
		:global(html[data-motion='running']) .partners__rows::before {
			left: 0;
			background: linear-gradient(to right, var(--color-dark-blue), transparent);
		}
		:global(html[data-motion='running']) .partners__rows::after {
			right: 0;
			background: linear-gradient(to left, var(--color-dark-blue), transparent);
		}
		:global(html[data-motion='running']) .partners__track {
			width: max-content;
			flex-wrap: nowrap;
			gap: 0;
			padding-inline: 0;
			animation: scroll var(--duration) linear infinite;
		}
		:global(html[data-motion='running']) .partners__track--reverse { animation-direction: reverse; }
		:global(html[data-motion='running']) .partners__track:hover,
		:global(html[data-motion='running']) .partners:focus-visible .partners__track { animation-play-state: paused; }
		:global(html[data-motion='running']) .partners__logo { display: flex; margin-inline: var(--space-9); }
	}

	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

</style>
