---
import { Image } from 'astro:assets';
import Icon from './icons/Icon.astro';
import type { IconName } from '../lib/icons';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// On phones only the first few cards show until "Show more" is pressed.
const mobileLimit = 3;

const socials = [
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/company/start-berlin-e-v-/',
		icon: 'linkedin' as IconName,
	},
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/start_berlin/',
		icon: 'instagram' as IconName,
	},
];
---

<section class="news" data-news>
	<div class="news__sticky" data-news-sticky>
		<div class="news__header">
			<h2 class="news__title">Latest News</h2>
			<div class="news__socials">
				{
					socials.map((social) => (
						<a href={social.href} target="_blank" rel="noopener" class="news__social">
							<Icon name={social.icon} />
							<span>{social.label}</span>
						</a>
					))
				}
			</div>
		</div>

		<div class="news__viewport" data-news-viewport>
			<div class="news__track" data-news-track>
				{
					posts.map((post, index) => (
						<a
							href={post.data.url}
							target="_blank"
							rel="noopener"
							class="news__card"
							style={post.data.image && `--ratio: ${post.data.image.width} / ${post.data.image.height}`}
							data-extra={index >= mobileLimit ? '' : undefined}
						>
							{post.data.image ? (
								<Image
									src={post.data.image}
									alt={post.data.title}
									widths={[480, 960]}
									sizes="(max-width: 767px) 100vw, 480px"
									class="news__image"
								/>
							) : (
								<div class="news__placeholder" />
							)}
							<div class="news__shade" />
							<div class="news__text">
								<div class="news__card-title">{post.data.title}</div>
								<p class="news__card-description">{post.data.description}</p>
							</div>
							<div class="news__external">
								<Icon name="external-link" />
							</div>
						</a>
					))
				}
			</div>
		</div>

		{
			posts.length > mobileLimit && (
				<button class="news__more" data-news-more>
					Show more
				</button>
			)
		}
	</div>
</section>

<script>
	// Desktop: the section is pinned while vertical scrolling slides the cards
	// sideways. The section is made taller by exactly the horizontal overflow so
	// the last card arrives as the pin releases.
	const section = document.querySelector<HTMLElement>('[data-news]');

	if (section) {
		const sticky = section.querySelector<HTMLElement>('[data-news-sticky]')!;
		const viewport = section.querySelector<HTMLElement>('[data-news-viewport]')!;
		const track = section.querySelector<HTMLElement>('[data-news-track]')!;
		const desktop = window.matchMedia('(min-width: 768px)');
		const headerHeight = 80;
		let frame = 0;

		const overflow = () => Math.max(0, track.scrollWidth - viewport.clientWidth);

		const update = () => {
			const distance = overflow();
			if (!desktop.matches || distance === 0) {
				track.style.transform = '';
				return;
			}
			const start = section.getBoundingClientRect().top + window.scrollY - headerHeight;
			// Near the bottom of the page there may be less scroll left than the
			// pinned range, so finish the slide within whatever is reachable.
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const range = Math.min(section.offsetHeight - sticky.offsetHeight, maxScroll - start);
			const progress = range > 0 ? Math.min(1, Math.max(0, (window.scrollY - start) / range)) : 0;
			track.style.transform = `translateX(-${progress * distance}px)`;
		};

		const resize = () => {
			section.style.height = desktop.matches ? `${sticky.offsetHeight + overflow()}px` : '';
			update();
		};

		window.addEventListener(
			'scroll',
			() => {
				if (frame) return;
				frame = requestAnimationFrame(() => {
					frame = 0;
					update();
				});
			},
			{ passive: true },
		);
		new ResizeObserver(resize).observe(viewport);
		desktop.addEventListener('change', resize);
		resize();

		section.querySelector('[data-news-more]')?.addEventListener('click', (event) => {
			section.classList.add('news--expanded');
			(event.currentTarget as HTMLElement).remove();
		});
	}
</script>

<style>
	.news {
		position: relative;
		padding-inline: 1rem;
	}

	.news__sticky {
		max-width: 80rem;
		margin-inline: auto;
		padding-block: 7rem;
	}

	.news__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 1rem 1.5rem;
		margin-bottom: 3rem;
	}

	.news__title {
		margin: 0;
		font-size: 3rem;
		font-weight: 900;
		line-height: 1;
		text-transform: uppercase;
	}

	.news__socials {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 0.25rem;
	}

	.news__social {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1.25rem;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.25rem;
		background: rgb(255 255 255 / 0.05);
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 9999px;
		transition: all 300ms;
	}

	.news__social svg {
		width: 1rem;
		height: 1rem;
	}

	.news__social:hover {
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
	}

	.news__track {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.news__card {
		position: relative;
		display: block;
		/* Each card keeps its post image's proportions; 4:5 when there is no image. */
		aspect-ratio: var(--ratio, 4 / 5);
		overflow: hidden;
		border-radius: 1rem;
	}

	.news__card[data-extra] {
		display: none;
	}

	.news--expanded .news__card[data-extra] {
		display: block;
	}

	.news__image,
	.news__placeholder {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 500ms;
	}

	.news__placeholder {
		background: linear-gradient(
			to bottom right,
			color-mix(in srgb, var(--color-accent) 30%, transparent),
			rgb(59 7 100 / 0.5)
		);
	}

	.news__card:hover .news__image {
		transform: scale(1.05);
	}

	.news__shade {
		position: absolute;
		inset: 0;
		/* Stronger than Munich's fade: most post images are graphics with their own
		   text near the bottom, which would otherwise clash with the card title. */
		background: linear-gradient(to top, rgb(0 0 0 / 0.9), rgb(0 0 0 / 0.65) 25%, transparent 55%);
	}

	.news__text {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		left: 1.5rem;
	}

	.news__card-title {
		margin-bottom: 0.25rem;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.75rem;
	}

	.news__card-description {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: rgb(255 255 255 / 0.7);
	}

	.news__external {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		background: rgb(255 255 255 / 0.2);
		border-radius: 9999px;
		backdrop-filter: blur(4px);
		opacity: 0;
		transition: opacity 150ms;
	}

	.news__external svg {
		width: 1rem;
		height: 1rem;
	}

	.news__card:hover .news__external {
		opacity: 1;
	}

	.news__more {
		width: 100%;
		margin-top: 1.5rem;
		padding-block: 1rem;
		font-weight: 500;
		color: rgb(255 255 255 / 0.7);
		border: 1px solid rgb(255 255 255 / 0.2);
		border-radius: 1rem;
		transition: all 300ms;
	}

	.news__more:hover {
		color: var(--color-white);
		border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
	}

	@media (min-width: 640px) {
		.news {
			padding-inline: 1.5rem;
		}

		.news__title {
			font-size: 3.75rem;
		}
	}

	@media (min-width: 768px) {
		.news__sticky {
			position: sticky;
			top: 5rem;
		}

		.news__viewport {
			overflow: hidden;
		}

		.news__track {
			flex-direction: row;
			width: max-content;
			will-change: transform;
		}

		.news__card,
		.news__card[data-extra] {
			display: block;
			/* Same height for every card; the width follows the image. */
			width: auto;
			height: 475px;
			flex-shrink: 0;
		}

		.news__more {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.news {
			padding-inline: 2rem;
		}
	}
</style>
