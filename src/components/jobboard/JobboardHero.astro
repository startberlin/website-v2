---
import PageHero from '../PageHero.astro';
import companyVisit from '../../assets/jobboard/company-visit.webp';
import Icon from '../icons/Icon.astro';
---

<PageHero image={companyVisit} alt="START Berlin members attending a company visit in an open office." imagePosition="50% 57%" mobileImagePosition="58% 55%">
	<Fragment slot="title">Jobs</Fragment>
	<Fragment slot="description">Open roles from companies in our network. Apply directly with the team.</Fragment>
	<a slot="aside" class="jb-button" href="/jobs/submit">Post a role <Icon name="arrow-up-right" size={20} /></a>
</PageHero>
