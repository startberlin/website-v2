---
import { Image } from 'astro:assets';
import companyVisit from '../../assets/jobboard/company-visit.webp';
import Icon from '../icons/Icon.astro';
---

<header class="jb-hero">
	<Image
		src={companyVisit}
		alt="START Berlin members attending a company visit in an open office."
		widths={[480, 768, 1200]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		class="jb-hero__image"
	/>
	<div class="jb-hero__shade jb-hero__shade--left" aria-hidden="true"></div>
	<div class="jb-hero__shade jb-hero__shade--bottom" aria-hidden="true"></div>
	<div class="jb-hero__content">
		<div>
			<h1 class="jb-hero__title">Jobs</h1>
			<p class="jb-hero__text">Open roles from companies in our network. Apply directly with the team.</p>
		</div>
		<a class="jb-button jb-hero__action" href="/jobs/submit">
			Post a role
			<Icon name="arrow-up-right" size={20} />
		</a>
	</div>
</header>

<style>
	.jb-hero {
		position: relative;
		display: flex;
		align-items: end;
		min-height: 22.5rem;
		overflow: hidden;
		isolation: isolate;
	}

	.jb-hero__image,
	.jb-hero__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
	}

	.jb-hero__image {
		object-fit: cover;
		object-position: 58% 55%;
	}

	.jb-hero__shade--left {
		background: linear-gradient(to right, rgb(0 0 44 / 0.94), rgb(0 0 44 / 0.65) 55%, rgb(0 0 44 / 0.2));
	}

	.jb-hero__shade--bottom {
		background: linear-gradient(to top, var(--color-dark-blue), transparent 75%);
	}

	.jb-hero__content {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		padding: 3rem 1.25rem 2rem;
	}

	.jb-hero__title {
		margin: 0;
		color: var(--color-white);
		font-size: clamp(3.5rem, 7vw, 5.5rem);
		font-weight: 900;
		letter-spacing: -0.035em;
		line-height: 1;
		text-transform: uppercase;
	}

	.jb-hero__text {
		max-width: 30rem;
		margin: 1rem 0 0;
		color: rgb(255 255 255 / 0.86);
		font-size: 1rem;
		line-height: 1.65;
	}

	.jb-hero__action {
		flex-shrink: 0;
	}

	@media (min-width: 640px) {
		.jb-hero {
			min-height: 25rem;
		}

		.jb-hero__image {
			object-position: 50% 57%;
		}

		.jb-hero__content {
			padding: 3.5rem 2rem 2.75rem;
		}

		.jb-hero__text {
			font-size: 1.125rem;
		}
	}
</style>
