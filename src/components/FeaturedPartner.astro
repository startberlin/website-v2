---
import { Image } from 'astro:assets';
import xdeckLogo from '../assets/home/xdeck-logo.webp';
import Icon from './icons/Icon.astro';
---

<section id="featured-partner" class="featured-partner page-container" aria-labelledby="featured-partner-heading">
	<div class="featured-partner__panel">
		<h2 id="featured-partner-heading" class="featured-partner__heading">Featured Partner</h2>
		<div class="featured-partner__content">
			<Image src={xdeckLogo} alt="xdeck" width={256} quality="lossless" loading="lazy" class="featured-partner__logo" />
			<span class="featured-partner__name">xdeck</span>
			<p class="featured-partner__description">Accelerator and venture fund for early-stage B2B tech founders.</p>
			<a
				class="text-action"
				href="https://xdeck.de/?utm_source=start-berlin.com&amp;utm_medium=referral&amp;utm_campaign=featured-partner"
				rel="sponsored"
			>
				<span>Explore xdeck</span>
				<Icon name="arrow-up-right" size={16} />
			</a>
		</div>
	</div>
</section>

<style>
	.featured-partner { container-type: inline-size; }

	.featured-partner__panel {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		border: var(--border-width) solid var(--border-default);
		border-radius: var(--radius-card);
		background: var(--surface-card);
	}

	.featured-partner__heading {
		margin: 0;
		color: var(--color-accent);
		font-size: var(--text-caption);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		line-height: var(--leading-ui);
		text-transform: uppercase;
	}

	.featured-partner__content {
		display: grid;
		gap: var(--space-2);
		justify-items: start;
		align-items: center;
	}

	.featured-partner__logo {
		inline-size: var(--space-32);
		max-inline-size: 100%;
		block-size: auto;
	}

	.featured-partner__name { display: none; }

	.featured-partner__description {
		margin: 0;
		color: var(--text-copy);
		line-height: var(--leading-ui);
		text-wrap: balance;
	}

	@container (min-width: 42rem) {
		.featured-partner__panel { padding: var(--space-6) var(--space-8); }

		.featured-partner__content {
			grid-template-columns: auto minmax(0, 1fr) auto;
			column-gap: var(--space-6);
		}

		.featured-partner__description {
			padding-inline-start: var(--space-6);
			border-inline-start: var(--border-width) solid var(--border-default);
		}
	}

	@media (forced-colors: active) {
		.featured-partner__logo { display: none; }

		.featured-partner__name {
			display: block;
			font-size: var(--text-2xl);
			font-weight: var(--weight-bold);
		}
	}
</style>
