---
import Icon from './icons/Icon.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

// Navigation structure mirrors startmunich.de. Entries whose START Berlin page
// doesn't exist yet are left out until it does.
interface NavLink {
	label: string;
	href: string;
	newTab?: boolean;
}

interface NavGroup {
	label: string;
	items: NavLink[];
	// Smaller, dimmed links shown below a divider (desktop) or in lighter text (mobile).
	secondary?: NavLink[];
}

type NavEntry = NavLink | NavGroup;

const nav: NavEntry[] = [
	{ label: 'Home', href: '/' },
	{
		label: 'Community',
		items: [{ label: 'Our Members', href: '/members' }],
	},
];

const ctas: NavLink[] = [
	{ label: 'Apply Now', href: '/join' },
	{ label: 'Jobs', href: '/jobs' },
];

const isGroup = (entry: NavEntry): entry is NavGroup => 'items' in entry;
const linkAttrs = (link: NavLink) =>
	link.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<nav class="nav">
	<div class="nav__bar">
		<a href="/" class="logo">
			<Image src={logo} alt="START Berlin" class="logo__image" loading="eager" />
		</a>

		<div class="nav__links">
			{
				nav.map((entry) =>
					isGroup(entry) ? (
						<div class="dropdown" data-dropdown>
							<button class="nav__link dropdown__toggle" aria-expanded="false" aria-haspopup="menu">
								<span>{entry.label}</span>
								<Icon name="chevron-down" class="chevron" />
							</button>
							<div class="dropdown__panel" data-dropdown-panel hidden>
								{entry.items.map((item) => (
									<a href={item.href} {...linkAttrs(item)} class="dropdown__item">
										<Icon name="chevron-right" />
										{item.label}
									</a>
								))}
								{entry.secondary && <div class="dropdown__divider" />}
								{entry.secondary?.map((item) => (
									<a href={item.href} {...linkAttrs(item)} class="dropdown__item dropdown__item--secondary">
										<Icon name="chevron-right" />
										{item.label}
									</a>
								))}
							</div>
						</div>
					) : (
						<a href={entry.href} {...linkAttrs(entry)} class="nav__link">
							{entry.label}
						</a>
					),
				)
			}
		</div>

		<div class="cta-group cta-group--desktop">
			{ctas.map((cta) => <a href={cta.href} {...linkAttrs(cta)} class="cta">{cta.label}</a>)}
		</div>

		<button class="menu-button" aria-label="Open menu" aria-expanded="false" data-menu-open>
			<Icon name="menu" />
		</button>
	</div>

	<div class="mobile-menu" data-mobile-menu hidden>
		<div class="mobile-menu__bar">
			<a href="/" class="logo">
				<Image src={logo} alt="START Berlin" class="logo__image" loading="eager" />
			</a>
			<button class="menu-button" aria-label="Close menu" data-menu-close>
				<Icon name="close" />
			</button>
		</div>

		<div class="mobile-menu__body">
			{
				nav.map((entry) =>
					isGroup(entry) ? (
						<div class="mobile-menu__group">
							<button class="mobile-menu__link mobile-menu__toggle" aria-expanded="false" data-accordion>
								<span>{entry.label}</span>
								<Icon name="chevron-down" class="chevron" />
							</button>
							<div class="mobile-menu__sublinks" hidden>
								{entry.items.map((item) => (
									<a href={item.href} {...linkAttrs(item)} class="mobile-menu__sublink">
										{item.label}
									</a>
								))}
								{entry.secondary?.map((item) => (
									<a
										href={item.href}
										{...linkAttrs(item)}
										class="mobile-menu__sublink mobile-menu__sublink--secondary"
									>
										{item.label}
									</a>
								))}
							</div>
						</div>
					) : (
						<a href={entry.href} {...linkAttrs(entry)} class="mobile-menu__link">
							{entry.label}
						</a>
					),
				)
			}

			<div class="cta-group cta-group--mobile">
				{ctas.map((cta) => <a href={cta.href} {...linkAttrs(cta)} class="cta">{cta.label}</a>)}
			</div>
		</div>
	</div>
</nav>

<script>
	// Hover-to-open only on devices with a real pointer; touch devices use tap.
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

	document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
		const toggle = dropdown.querySelector('button')!;
		const panel = dropdown.querySelector<HTMLElement>('[data-dropdown-panel]')!;
		let closeTimer: ReturnType<typeof setTimeout> | undefined;

		const setOpen = (open: boolean) => {
			clearTimeout(closeTimer);
			panel.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
		};

		toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));

		// The short delay lets the pointer cross the gap between button and panel.
		dropdown.addEventListener('mouseenter', () => canHover.matches && setOpen(true));
		dropdown.addEventListener('mouseleave', () => {
			if (!canHover.matches) return;
			clearTimeout(closeTimer);
			closeTimer = setTimeout(() => setOpen(false), 150);
		});

		panel.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setOpen(false);
		});

		document.addEventListener('mousedown', (event) => {
			if (!dropdown.contains(event.target as Node)) setOpen(false);
		});
	});

	const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]')!;
	const menuOpen = document.querySelector<HTMLElement>('[data-menu-open]')!;
	const menuClose = mobileMenu.querySelector<HTMLElement>('[data-menu-close]')!;
	const pageMain = document.querySelector<HTMLElement>('main');
	const pageFooter = document.querySelector<HTMLElement>('footer');
	const originalOverflow = document.body.style.overflow;

	const setMenuOpen = (open: boolean) => {
		mobileMenu.hidden = !open;
		menuOpen.setAttribute('aria-expanded', String(open));
		if (pageMain) pageMain.inert = open;
		if (pageFooter) pageFooter.inert = open;
		document.body.style.overflow = open ? 'hidden' : originalOverflow;
		if (open) menuClose.focus();
		else menuOpen.focus();
	};

	menuOpen.addEventListener('click', () => setMenuOpen(true));
	mobileMenu.querySelector('[data-menu-close]')!.addEventListener('click', () => setMenuOpen(false));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			if (!mobileMenu.hidden) setMenuOpen(false);
			document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
				const panel = dropdown.querySelector<HTMLElement>('[data-dropdown-panel]')!;
				if (!panel.hidden) {
					panel.hidden = true;
					const toggle = dropdown.querySelector('button')!;
					toggle.setAttribute('aria-expanded', 'false');
					if (dropdown.contains(document.activeElement)) toggle.focus();
				}
			});
		}
		if (event.key !== 'Tab' || mobileMenu.hidden) return;
		const controls = [...mobileMenu.querySelectorAll<HTMLElement>('a[href], button')]
			.filter((element) => element.getClientRects().length > 0);
		const first = controls[0];
		const last = controls.at(-1);
		if (event.shiftKey && document.activeElement === first) {
			event.preventDefault();
			last?.focus();
		} else if (!event.shiftKey && document.activeElement === last) {
			event.preventDefault();
			first?.focus();
		}
	});
	window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
		if (event.matches && !mobileMenu.hidden) setMenuOpen(false);
	});
	mobileMenu.addEventListener('click', (event) => {
		if ((event.target as Element).closest('a')) setMenuOpen(false);
	});

	mobileMenu.querySelectorAll<HTMLElement>('[data-accordion]').forEach((toggle) => {
		const sublinks = toggle.nextElementSibling as HTMLElement;
		toggle.addEventListener('click', () => {
			sublinks.hidden = !sublinks.hidden;
			toggle.setAttribute('aria-expanded', String(!sublinks.hidden));
		});
	});
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: var(--z-navigation);
		background: var(--color-dark-blue);
	}

	.nav__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-height);
		padding-inline: var(--space-10);
	}

	.logo {
		display: flex;
		align-items: center;
		transition: opacity var(--duration-fast);
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo__image {
		width: auto;
		height: 3rem;
	}

	.nav__links {
		display: none;
		align-items: center;
		gap: var(--space-8);
	}

	.nav__link {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--text-base);
		line-height: 1.5rem;
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		transition: color var(--duration-fast);
	}

	.nav__link:hover {
		color: var(--color-accent);
	}

	.chevron {
		width: 1rem;
		height: 1rem;
		transition: transform var(--duration-fast);
	}

	[aria-expanded='true'] > .chevron {
		transform: rotate(180deg);
	}

	.dropdown {
		position: relative;
	}

	.dropdown__panel {
		position: absolute;
		top: 100%;
		left: 0;
		width: 16rem;
		margin-top: var(--space-3);
		padding-block: var(--space-2);
		overflow: hidden;
		background: var(--color-dark-blue);
		border: var(--border-width) solid var(--border-strong);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-dropdown);
		animation: fade-in var(--duration-panel) ease-out;
	}

	.dropdown__item {
		display: flex;
		align-items: center;
		padding: 0.875rem var(--space-6);
		font-size: var(--text-base);
		line-height: 1.5rem;
		font-weight: var(--weight-bold);
		transition: background-color var(--duration-ui), color var(--duration-ui);
	}

	.dropdown__item:hover {
		background: var(--color-accent);
		color: var(--color-dark-blue);
	}

	.dropdown__item svg {
		width: 1rem;
		height: 1rem;
		margin-right: var(--space-3);
		flex-shrink: 0;
		transition: transform var(--duration-fast);
	}

	.dropdown__item:hover svg {
		transform: translateX(0.25rem);
	}

	.dropdown__item--secondary {
		padding-block: 0.625rem;
		font-size: var(--text-sm);
		line-height: 1.25rem;
		font-weight: var(--weight-semibold);
		color: var(--text-muted);
	}

	.dropdown__item--secondary svg {
		width: 0.875rem;
		height: 0.875rem;
	}

	.dropdown__divider {
		margin: var(--space-1) var(--space-4);
		border-top: var(--border-width) solid var(--border-default);
	}

	.cta-group {
		display: flex;
		gap: 2px;
		overflow: hidden;
		border-radius: var(--radius-control);
		background: var(--color-dark-blue);
	}

	.cta-group--desktop {
		display: none;
	}

	.cta {
		padding: 0.375rem var(--space-4);
		background: var(--color-white);
		color: var(--color-dark-blue);
		font-size: var(--text-sm);
		line-height: 1.25rem;
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		transition: background-color var(--duration-panel), color var(--duration-panel);
	}

	.cta:hover {
		background: var(--color-accent);
		color: var(--color-dark-blue);
	}

	.cta:focus-visible,
	.nav__link:focus-visible,
	.menu-button:focus-visible,
	.mobile-menu a:focus-visible,
	.mobile-menu button:focus-visible {
		outline: var(--focus-width) solid var(--color-accent);
		outline-offset: var(--focus-offset);
	}

	.menu-button {
		padding: var(--space-2);
		line-height: 0;
	}

	.menu-button svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: var(--z-navigation);
		display: flex;
		flex-direction: column;
		overflow-y: auto;
		background: var(--color-dark-blue);
	}

	.mobile-menu__bar {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: space-between;
		height: var(--header-height);
		padding-inline: var(--space-10);
	}

	.mobile-menu__body {
		display: flex;
		flex-grow: 1;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-6) var(--space-10);
		border-top: var(--border-width) solid var(--border-subtle);
	}

	.mobile-menu__link,
	.mobile-menu__group {
		border-bottom: var(--border-width) solid var(--border-subtle);
	}

	.mobile-menu__link {
		display: block;
		padding-block: var(--space-4);
		font-size: var(--text-lg);
		line-height: 1.75rem;
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		transition: color var(--duration-fast);
	}

	.mobile-menu__link:hover {
		color: var(--color-accent);
	}

	.mobile-menu__toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		border-bottom: 0;
		text-align: left;
	}

	.mobile-menu__toggle .chevron {
		width: 1.25rem;
		height: 1.25rem;
	}

	.mobile-menu__sublinks {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-bottom: var(--space-3);
	}

	.mobile-menu__sublink {
		padding: 0.625rem 0 0.625rem var(--space-4);
		font-size: var(--text-base);
		line-height: 1.5rem;
		font-weight: var(--weight-semibold);
		color: var(--text-copy);
		transition: color var(--duration-fast);
	}

	.mobile-menu__sublink:hover {
		color: var(--color-accent);
	}

	.mobile-menu__sublink--secondary {
		padding-block: var(--space-2);
		font-size: var(--text-sm);
		line-height: 1.25rem;
		font-weight: var(--weight-medium);
		color: var(--text-subtle);
	}

	.cta-group--mobile {
		margin-top: var(--space-10);
	}

	.cta-group--mobile .cta {
		flex: 1;
		padding: var(--space-4) var(--space-6);
		text-align: center;
		font-size: var(--text-base);
		line-height: 1.5rem;
		font-weight: var(--weight-display);
		letter-spacing: normal;
	}

	@media (min-width: 1024px) {
		.nav__bar {
			padding-inline: var(--space-20);
		}

		.nav__links,
		.cta-group--desktop {
			display: flex;
		}

		.nav__bar > .menu-button,
		.mobile-menu {
			display: none;
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dropdown__panel { animation: none; }
	}
</style>
