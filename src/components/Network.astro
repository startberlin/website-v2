---
// Shared across the START Network; content matches startmunich.de.
const stats = [
	{ value: '22', label: 'Cities' },
	{ value: '17', label: 'Countries' },
	{ value: '+1800', label: 'Members' },
];

const cities = [
	'Berlin',
	'Barcelona',
	'Hamburg',
	'Helsinki',
	'Lausanne',
	'London',
	'Lima',
	'Lisbon',
	'Maastricht',
	'Mexico City',
	'Milano',
	'Munich',
	'Paris',
	'Nuremberg',
	'Quito',
	'São Paulo',
	'Stuttgart',
	'Vaduz',
	'Vienna',
	'Warsaw',
	'St. Gallen',
];

// Cycle through four text treatments so neighbouring names differ; our own
// city always gets the accent colour.
const tones = ['silver', 'white', 'grey', 'accent'];
const toneFor = (city: string, index: number) => (city === 'Berlin' ? 'accent' : tones[index % tones.length]);
---

<section class="network">
	<div class="network__inner">
		<h2 class="network__title">The START Network</h2>

		<div class="network__grid">
			<div class="network__info">
				<p class="network__text">
					We’re part of the international START Network, which includes many chapters across Europe and
					South America. This connection allows us to exchange knowledge, collaborate internationally, and
					give our members access to the broader entrepreneurial ecosystem. Through the network, members can
					engage with a wide range of peers, attend international events like the START Summit, and gain
					insights from different regional startup environments.
				</p>

				<svg class="network__globe" viewBox="0 0 200 200" aria-hidden="true">
					<circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
					<ellipse cx="100" cy="100" rx="80" ry="30" fill="none" stroke="currentColor" stroke-width="1"
					></ellipse>
					<ellipse cx="100" cy="100" rx="80" ry="55" fill="none" stroke="currentColor" stroke-width="0.75"
					></ellipse>
					<line x1="20" y1="100" x2="180" y2="100" stroke="currentColor" stroke-width="0.75"></line>
					<ellipse cx="100" cy="100" rx="30" ry="80" fill="none" stroke="currentColor" stroke-width="1"
					></ellipse>
					<ellipse cx="100" cy="100" rx="55" ry="80" fill="none" stroke="currentColor" stroke-width="0.75"
					></ellipse>
					<line x1="100" y1="20" x2="100" y2="180" stroke="currentColor" stroke-width="0.75"></line>
				</svg>

				<dl class="network__stats">
					{
						stats.map((stat) => (
							<div>
								<dt class="network__stat-label">{stat.label}</dt>
								<dd class="network__stat-value">{stat.value}</dd>
							</div>
						))
					}
				</dl>
			</div>

			<div class="network__cities">
				<ul class="network__city-list" aria-label="START Network cities">
					{
						[...cities, ...cities].map((city, index) => (
							<li
								class:list={['network__city', `network__city--${toneFor(city, index % cities.length)}`]}
								aria-hidden={index >= cities.length ? 'true' : undefined}
							>
								{city}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.network {
		position: relative;
		overflow: hidden;
		padding: var(--space-28) var(--page-gutter);
	}

	.network__inner {
		max-width: var(--layout-page);
		margin-inline: auto;
	}

	.network__title {
		margin: 0 0 var(--space-10);
		font-size: var(--type-home-section);
		font-weight: var(--weight-display);
		line-height: 1;
		text-transform: uppercase;
	}

	.network__grid {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: var(--space-16);
	}

	.network__info {
		position: relative;
	}

	.network__text {
		max-width: 28rem;
		margin: 0 0 var(--space-16);
		font-size: var(--text-lg);
		line-height: 1.625;
		color: var(--text-copy);
	}

	.network__globe {
		position: absolute;
		bottom: -2.5rem;
		left: -2.5rem;
		width: 18rem;
		height: 18rem;
		color: var(--color-white);
		opacity: 0.15;
	}

	.network__stats {
		position: relative;
		z-index: var(--z-decoration);
		display: flex;
		gap: var(--space-8);
		margin: 0;
	}

	.network__stats > div {
		display: flex;
		flex-direction: column-reverse;
	}

	.network__stat-value {
		margin: 0;
		font-size: var(--type-home-section);
		font-weight: var(--weight-display);
		line-height: 1;
	}

	.network__stat-label {
		font-size: var(--text-sm);
		line-height: 1.25rem;
		color: var(--text-subtle);
	}

	.network__cities {
		position: relative;
		height: 400px;
		overflow: hidden;
	}

	/* Fade the list in and out at the top and bottom edges. */
	.network__cities::before,
	.network__cities::after {
		content: '';
		position: absolute;
		right: 0;
		left: 0;
		z-index: var(--z-decoration);
		height: var(--header-height);
		pointer-events: none;
	}

	.network__cities::before {
		top: 0;
		background: linear-gradient(to bottom, var(--color-dark-blue), transparent);
	}

	.network__cities::after {
		bottom: 0;
		background: linear-gradient(to top, var(--color-dark-blue), transparent);
	}

	.network__city-list {
		margin: var(--space-12) 0 0;
		padding: 0;
		list-style: none;
		text-align: right;
		animation: scroll-up 20s linear infinite;
	}

	.network__city {
		font-size: var(--type-home-section);
		font-weight: var(--weight-display);
		line-height: 1.2;
		text-transform: uppercase;
	}

	.network__city--white {
		color: var(--color-white);
	}

	.network__city--accent {
		color: var(--color-accent);
	}

	.network__city--silver,
	.network__city--grey {
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}

	.network__city--silver {
		background-image: var(--gradient-network-silver);
	}

	.network__city--grey {
		background-image: var(--gradient-network-grey);
	}

	@keyframes scroll-up {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-50%);
		}
	}

	@media (min-width: 640px) {
		.network__title,
		.network__stat-value,
		.network__city {
			font-size: var(--type-home-section-wide);
		}

		.network__stats {
			gap: var(--space-16);
		}
	}

	@media (min-width: 1024px) {
		.network__grid {
			grid-template-columns: 1fr 1fr;
		}

		.network__city {
			font-size: var(--type-network-city-wide);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.network__city-list {
			animation: none;
		}
	}
</style>
