---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './icons/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import workshopPhoto from '../assets/events/workshops.jpg';

interface Props {
	photo?: ImageMetadata;
}

const { photo = workshopPhoto } = Astro.props;
---

<section class="newsletter" id="newsletter" aria-labelledby="newsletter-title" tabindex="-1">
	<Image src={photo} alt="" widths={[640, 1080].filter((width) => width < photo.width).concat(Math.min(photo.width, 1600))} sizes="100vw" format="webp" loading="lazy" class="newsletter__image" />
	<div class="newsletter__shade" aria-hidden="true"></div>
	<div class="newsletter__content page-container">
		<div class="newsletter__copy">
			<SectionHeading id="newsletter-title">
				The next round<br />
				<span data-outline>In your inbox</span>
				<Fragment slot="lead">Get the START Berlin newsletter and updates on when applications open.</Fragment>
			</SectionHeading>
			<form action="/newsletter" method="post" aria-labelledby="newsletter-title" data-newsletter-signup>
				<div class="newsletter__fields">
					<div>
						<label class="newsletter__label" for="newsletter-email">Email address</label>
						<input class="ui-control" id="newsletter-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="newsletter-privacy-note" />
					</div>
					<button class="button" data-accent type="submit">
						Join the newsletter <Icon name="arrow-right" size={16} />
					</button>
				</div>
				<div hidden><label for="newsletter-website">Website</label><input id="newsletter-website" name="website" autocomplete="off" tabindex="-1" /></div>
				<p class="newsletter__note" id="newsletter-privacy-note">Confirm your sign-up by email. Unsubscribe at any time. <a href="/privacy-policy#newsletter-privacy">Privacy policy</a></p>
			</form>
			<p class="newsletter__feedback" role="status" data-newsletter-feedback></p>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-newsletter-signup]');
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const feedback = document.querySelector<HTMLElement>('[data-newsletter-feedback]');
	if (form && button && feedback) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (button.disabled) return;
			button.disabled = true;
			feedback.textContent = 'Sending your confirmation email…';
			const body = new URLSearchParams();
			for (const [name, value] of new FormData(form)) {
				if (typeof value === 'string') body.append(name, value);
			}
			try {
				const response = await fetch(form.action, {
					method: 'POST', body, headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(15_000),
				});
				const result = await response.json();
				if (typeof result.message !== 'string') throw new Error('Missing response message');
				feedback.textContent = result.message;
				if (response.status === 202) form.reset();
			} catch {
				feedback.textContent = 'The newsletter sign-up is temporarily unavailable. Please try again later.';
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.newsletter {
		position: relative;
		isolation: isolate;
	}

	.newsletter:focus-visible { outline-offset: calc(-1 * var(--focus-offset)); }

	.newsletter__image,
	.newsletter__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.newsletter__image { z-index: -2; object-fit: cover; }
	.newsletter__shade { z-index: -1; background: var(--gradient-hero-bottom), var(--gradient-photo-band); }
	.newsletter__content { padding-block: var(--space-page-start); }
	.newsletter__copy { max-width: var(--layout-reading); container-type: inline-size; }

	.newsletter__fields {
		display: grid;
		align-items: end;
		gap: var(--space-3);
		min-width: 0;
	}

	.newsletter__fields .button { text-transform: uppercase; letter-spacing: var(--tracking-label); }

	.newsletter__label {
		display: block;
		margin-bottom: var(--space-2);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
	}

	.newsletter__note,
	.newsletter__feedback:not(:empty) { margin: var(--space-3) 0 0; }
	.newsletter__note { font-size: var(--text-sm); line-height: var(--leading-copy); }
	.newsletter__note a { color: inherit; text-decoration: underline; }
	.newsletter__feedback:empty { margin: 0; }

	@container (min-width: 34rem) {
		.newsletter__fields { grid-template-columns: minmax(0, 1fr) auto; }
	}

	@media (max-width: 639.98px) {
		.newsletter__shade { background: var(--gradient-hero-mobile), var(--gradient-photo-band); }
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html[data-motion='running']:has(#newsletter:target)) { scroll-behavior: smooth; }
	}

</style>
