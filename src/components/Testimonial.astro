---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	quote: string;
	name: string;
	role: string;
	portrait?: ImageMetadata;
	featured?: boolean;
	/** card: framed quote card. pull: editorial quote without a frame, for story sections. */
	variant?: 'card' | 'pull';
}

const { quote, name, role, portrait, featured = false, variant = 'card' } = Astro.props;
const pull = variant === 'pull';
const size = pull ? (featured ? 80 : 56) : featured ? 128 : 64;
const widths = portrait ? [size, size * 2].filter((width) => width <= portrait.width) : [];

// First and last name, as in MemberCard.
const parts = name.split(/\s+/);
const initials = (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
---

<figure class:list={['testimonial', { 'testimonial--featured': featured && !pull, 'testimonial--pull': pull, 'testimonial--pull-featured': featured && pull }]}>
	{pull && <span class="testimonial__mark" aria-hidden="true">“</span>}
	<blockquote class="testimonial__quote">
		<p>{pull ? quote : `“${quote}”`}</p>
	</blockquote>
	<figcaption class="testimonial__author">
		<span class="testimonial__avatar">
			{portrait ? (
				<Image src={portrait} alt={`Portrait of ${name}`} width={size} height={size} widths={widths.length ? widths : undefined} sizes={`${size}px`} format="webp" loading="lazy" decoding="async" class="testimonial__portrait" />
			) : <span aria-hidden="true">{initials}</span>}
		</span>
		<span class="testimonial__meta">
			<span class="testimonial__name">{name}</span>
			<span class="testimonial__role">{role}</span>
		</span>
	</figcaption>
</figure>

<style>
	.testimonial {
		--avatar-size: 4rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		height: 100%;
		margin: 0;
		padding: var(--space-8) var(--space-6);
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-card);
		background: var(--surface-card);
	}

	.testimonial__quote {
		margin: 0;
	}

	.testimonial__quote p {
		margin: 0;
		color: var(--text-copy);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
	}

	.testimonial__author {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		min-width: 0;
	}

	.testimonial__avatar {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: var(--avatar-size);
		max-width: 100%;
		aspect-ratio: 1;
		overflow: hidden;
		border: var(--border-width) solid var(--border-subtle);
		border-radius: var(--radius-pill);
		background: var(--gradient-avatar);
		font-weight: var(--weight-display);
	}

	.testimonial__portrait {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.testimonial__meta {
		min-width: 0;
	}

	.testimonial__name {
		display: block;
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.testimonial__role {
		display: block;
		margin-top: var(--space-1);
		color: var(--text-muted);
		font-size: var(--text-sm);
	}

	/* Featured: a larger quote with a larger portrait and an accent frame. */
	.testimonial--featured {
		--avatar-size: 8rem;
		container: testimonial / inline-size;
		padding: var(--space-10) var(--space-6);
		border-color: var(--border-accent);
		background: var(--surface-accent);
	}

	.testimonial--featured .testimonial__quote p {
		max-width: var(--layout-reading);
		color: var(--color-white);
		font-size: var(--text-2xl);
		font-weight: var(--weight-medium);
		line-height: 1.45;
	}

	.testimonial--featured .testimonial__avatar {
		border: var(--border-width-accent) solid var(--color-accent);
	}

	@container testimonial (min-width: 40rem) {
		.testimonial__quote,
		.testimonial__author {
			padding-inline: var(--space-4);
		}
	}

	/* Pull: an editorial quote without a frame. A large accent mark opens it, a thin
	   accent rule runs beside the text and the portrait carries the accent ring. */
	.testimonial--pull {
		--avatar-size: 3.5rem;
		justify-content: start;
		gap: var(--space-6);
		height: auto;
		padding: 0 0 0 var(--space-6);
		border: 0;
		border-left: var(--border-width-accent) solid var(--border-accent);
		border-radius: 0;
		background: none;
	}

	/* The mark opens the quote inside the accent rule; its box is cropped to the
	   glyph so it sits directly above the first line. */
	.testimonial__mark {
		display: block;
		height: 0.42em;
		margin-bottom: calc(-1 * var(--space-2));
		color: var(--color-accent);
		font-size: var(--type-section);
		font-weight: var(--weight-display);
		line-height: 1;
	}

	.testimonial--pull .testimonial__quote p {
		max-width: var(--layout-reading);
		color: var(--color-white);
		font-size: var(--text-xl);
		font-weight: var(--weight-medium);
		line-height: 1.5;
	}

	.testimonial--pull .testimonial__avatar {
		border: var(--border-width-accent) solid var(--color-accent);
	}

	.testimonial--pull-featured {
		--avatar-size: 5rem;
	}

	/* Featured pull quotes grow with the viewport, from 20 px on phones to 28 px. */
	.testimonial--pull-featured .testimonial__quote p {
		max-width: 40rem;
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.01em;
		line-height: 1.4;
	}

	@media (min-width: 768px) {
		.testimonial--pull-featured .testimonial__quote p { font-size: var(--text-2xl); }
	}

	@media (min-width: 1024px) {
		.testimonial--pull-featured .testimonial__quote p { font-size: var(--text-3xl); line-height: 1.35; }
	}
</style>
