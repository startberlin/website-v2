---
interface Props {
	id: string;
	level?: 2 | 3;
	eyebrow?: string;
	compact?: boolean;
	flush?: boolean;
}

const { id, level = 2, eyebrow, compact = false, flush = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<div class:list={['section-heading', { 'section-heading--compact': compact, 'section-heading--flush': flush }]}>
	{eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
	<Heading id={id} class="section-heading__title"><slot /></Heading>
	{Astro.slots.has('lead') && <p class="section-heading__lead"><slot name="lead" /></p>}
</div>

<style>
	.section-heading {
		min-width: 0;
		margin-bottom: var(--space-heading);
	}

	.section-heading--flush { margin-bottom: 0; }

	.section-heading__eyebrow {
		margin: 0 0 var(--space-4);
		color: var(--color-accent);
		font-size: var(--text-caption);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-eyebrow);
		line-height: var(--leading-ui);
		text-transform: uppercase;
	}

	.section-heading__title {
		margin: 0;
		font-size: var(--type-section);
		font-weight: var(--weight-display);
		letter-spacing: -0.025em;
		line-height: var(--leading-display);
		text-transform: uppercase;
		text-wrap: balance;
		hyphens: auto;
	}

	.section-heading__title :global([data-outline]) {
		-webkit-text-stroke: var(--border-width-accent) var(--color-white);
		-webkit-text-fill-color: transparent;
		paint-order: stroke fill;
	}

	.section-heading__lead {
		max-width: var(--layout-reading);
		margin: var(--space-4) 0 0;
		color: var(--text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-copy);
	}

	.section-heading--compact .section-heading__title { font-size: var(--text-3xl); }
	.section-heading--compact .section-heading__lead { font-size: var(--text-base); }

	@media (forced-colors: active) {
		.section-heading__title :global([data-outline]) {
			-webkit-text-stroke: 0;
			-webkit-text-fill-color: CanvasText;
		}
	}
</style>
