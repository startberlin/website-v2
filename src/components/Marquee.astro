---
// Horizontally scrolling banner for any inline content (logos, cities, a short
// announcement). The slot renders twice for a seamless loop; the copy is hidden
// from assistive technology and keyboard focus. It stops on hover and keyboard
// focus and follows the system motion setting: with reduced motion it becomes a
// still row that scrolls sideways.
interface Props {
	/** Accessible name of the banner region. */
	label: string;
	/** Seconds for one full loop. */
	duration?: number;
}

const { label, duration = 50 } = Astro.props;
const content = await Astro.slots.render('default');
---

<div class="marquee" role="region" aria-label={label} style={`--marquee-duration: ${duration}s`}>
	<div class="marquee__track">
		<div class="marquee__group"><Fragment set:html={content} /></div>
		<div class="marquee__group" aria-hidden="true" inert><Fragment set:html={content} /></div>
	</div>
</div>

<style>
	/* Fade the content out at both edges. */
	.marquee {
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
	}

	.marquee__track {
		display: flex;
		width: max-content;
		animation: marquee var(--marquee-duration) linear infinite;
	}

	.marquee:hover .marquee__track,
	.marquee:focus-within .marquee__track {
		animation-play-state: paused;
	}

	/* The trailing padding equals the gap inside a group, so the loop has no seam. */
	.marquee__group {
		display: flex;
		flex-shrink: 0;
		padding-right: var(--space-16);
	}

	@keyframes marquee {
		to { transform: translateX(-50%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee { overflow-x: auto; mask-image: none; }
		.marquee__track { animation: none; }
		.marquee__group[aria-hidden] { display: none; }
	}
</style>
