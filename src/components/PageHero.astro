---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
	title: readonly [string, string];
	titleId?: string;
	accentFirst?: boolean;
	compactTitle?: boolean;
	alt?: string;
	imagePosition?: string;
	mobileImagePosition?: string;
} & (
	| { image: ImageMetadata; landing?: false }
	| { image?: never; landing: true }
);

const {
	title,
	titleId,
	accentFirst = false,
	compactTitle = false,
	image,
	alt = '',
	imagePosition = '50% 50%',
	mobileImagePosition = imagePosition,
	landing = false,
} = Astro.props;
// Reuse the original resolution rather than generating enlarged image files.
const imageWidths = image ? [...[640, 1080, 1600].filter((width) => width < image.width), Math.min(image.width, 2400)] : [];
---

<section
	class:list={['page-hero', {
		'page-hero--landing': landing,
		'page-hero--accent-first': accentFirst,
		'page-hero--compact-title': compactTitle,
	}]}
	style={`--hero-image-position: ${imagePosition}; --hero-mobile-image-position: ${mobileImagePosition};`}
	data-page-hero
>
	{image ? (
		<Image src={image} alt={alt} widths={imageWidths} sizes="100vw" format="webp" loading="eager" fetchpriority="high" class="page-hero__image" />
	) : <slot name="background" />}
	<div class="page-hero__shade" aria-hidden="true"></div>
	<div class="page-hero__foreground">
		<div class="page-hero__content page-container">
			<div class="page-hero__copy">
				<slot name="status" />
				<h1 class="page-hero__title" id={titleId}><span>{title[0]}</span>{' '}<span>{title[1]}</span></h1>
				{Astro.slots.has('description') && <p class="page-hero__text"><slot name="description" /></p>}
				<slot name="actions" />
			</div>
			<slot name="aside" />
		</div>
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		display: flex;
		align-items: end;
		min-height: var(--hero-height-mobile);
		padding-top: var(--hero-photo-space-mobile);
		overflow: hidden;
		isolation: isolate;
	}

	.page-hero__image,
	.page-hero__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.page-hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: var(--hero-mobile-image-position);
	}

	.page-hero__shade {
		z-index: -1;
		background: var(--gradient-hero-bottom);
	}

	.page-hero__foreground { position: relative; width: 100%; }

	/* Anchor the mobile shade to the copy, even when zoom makes the hero grow. */
	.page-hero__foreground::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--gradient-hero-mobile);
	}

	.page-hero__content {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-6) var(--space-8);
		padding-block: var(--space-12) var(--space-8);
	}

	.page-hero__copy { min-width: 0; max-width: 100%; }
	.page-hero__title {
		margin: 0;
		font-size: var(--type-hero);
		font-weight: var(--weight-display);
		letter-spacing: -0.035em;
		line-height: var(--leading-display);
		text-transform: uppercase;
		text-wrap: balance;
	}
	.page-hero__title span { display: block; }
	.page-hero__title span + span {
		color: var(--color-accent);
		-webkit-text-stroke: var(--border-width-accent) currentColor;
		-webkit-text-fill-color: transparent;
		paint-order: stroke fill;
	}
	.page-hero--accent-first .page-hero__title span:first-child { color: var(--color-accent); }
	.page-hero--accent-first .page-hero__title span + span { color: var(--color-white); }
	.page-hero--compact-title .page-hero__title { font-size: var(--type-hero-detail); }
	.page-hero--landing .page-hero__title { font-size: var(--type-hero-landing); }
	.page-hero__text {
		max-width: var(--layout-lead);
		margin: var(--space-4) 0 0;
		color: var(--text-copy);
		font-size: var(--text-base);
		line-height: var(--leading-copy);
	}

	@media (min-width: 640px) {
		.page-hero { min-height: var(--hero-height); padding-top: 0; }
		.page-hero__image { object-position: var(--hero-image-position); }
		.page-hero__shade { background: var(--gradient-hero-bottom), var(--gradient-hero); }
		.page-hero__foreground::before { display: none; }
		.page-hero__content { padding-block: var(--space-14) var(--space-10); }
		.page-hero__text { font-size: var(--text-lg); }
	}

	.page-hero--landing { min-height: calc(100svh - var(--header-height) - var(--announcement-height)); }
	.page-hero--landing .page-hero__content { padding-block-end: var(--home-partner-gap); }

	@media (forced-colors: active) {
		.page-hero__title span + span {
			-webkit-text-stroke: 0;
			-webkit-text-fill-color: CanvasText;
		}
	}
</style>
