---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image?: ImageMetadata;
	alt?: string;
	imagePosition?: string;
	mobileImagePosition?: string;
	contentWidth?: string;
	landing?: boolean;
}

const {
	image,
	alt = '',
	imagePosition = '50% 50%',
	mobileImagePosition = imagePosition,
	contentWidth = 'var(--layout-page)',
	landing = false,
} = Astro.props;
// Reuse the original resolution rather than generating enlarged image files.
const imageWidths = image ? [...[640, 1080, 1600].filter((width) => width < image.width), Math.min(image.width, 2400)] : [];
---

<section
	class:list={['page-hero', { 'page-hero--landing': landing }]}
	style={`--hero-image-position: ${imagePosition}; --hero-mobile-image-position: ${mobileImagePosition}; --hero-content-width: ${contentWidth};`}
	data-page-hero
>
	{image ? (
		<Image src={image} alt={alt} widths={imageWidths} sizes="100vw" format="webp" loading="eager" fetchpriority="high" class="page-hero__image" />
	) : <slot name="background" />}
	<div class="page-hero__shade page-hero__shade--left" aria-hidden="true"></div>
	<div class="page-hero__shade page-hero__shade--bottom" aria-hidden="true"></div>
	<div class="page-hero__content">
		<div class="page-hero__copy">
			<slot name="status" />
			<h1 class="page-hero__title"><slot name="title" /></h1>
			<p class="page-hero__text"><slot name="description" /></p>
			<slot name="actions" />
		</div>
		{Astro.slots.has('aside') && <div class="page-hero__aside"><slot name="aside" /></div>}
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		display: flex;
		align-items: end;
		min-height: 22.5rem;
		overflow: hidden;
		isolation: isolate;
	}

	.page-hero--landing {
		min-height: calc(100svh - var(--header-height));
	}

	.page-hero__image,
	.page-hero__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.page-hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: var(--hero-mobile-image-position);
	}

	.page-hero__shade { z-index: -1; }
	.page-hero__shade--left {
		background: var(--gradient-hero);
	}
	.page-hero__shade--bottom {
		background: linear-gradient(to top, var(--color-dark-blue), transparent 75%);
	}

	.page-hero__content {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-6) var(--space-8);
		width: 100%;
		max-width: var(--hero-content-width);
		margin-inline: auto;
		padding: var(--space-12) var(--page-gutter) var(--space-8);
	}

	.page-hero__copy { min-width: 0; max-width: 100%; }
	.page-hero__title {
		margin: 0;
		font-size: var(--type-hero);
		font-weight: var(--weight-display);
		letter-spacing: -0.035em;
		line-height: 1;
		text-transform: uppercase;
	}
	.page-hero__title :global([data-hero-line]) { display: block; }
	.page-hero__title :global([data-hero-accent]) { color: var(--color-accent); }
	.page-hero--landing .page-hero__title { font-size: var(--type-hero-landing); }
	.page-hero__text {
		max-width: 32rem;
		margin: var(--space-4) 0 0;
		color: var(--text-copy);
		font-size: var(--text-base);
		line-height: 1.65;
	}
	.page-hero__aside { flex-shrink: 0; }

	@media (min-width: 640px) {
		.page-hero { min-height: 25rem; }
		.page-hero--landing { min-height: calc(100svh - var(--header-height)); }
		.page-hero__image { object-position: var(--hero-image-position); }
		.page-hero__content { padding: var(--space-14) var(--page-gutter) 2.75rem; }
		.page-hero__text { font-size: var(--text-lg); }
	}

</style>
