---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageHero from './PageHero.astro';

const slides = Object.entries(
	import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.{jpg,jpeg,png,webp}', { eager: true }),
)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, module]) => module.default);
---

<PageHero landing title={['Student-led', 'Founder-minded']}>
	<Fragment slot="background">
		{slides.map((slide, index) => (
			<div class="hero__slide" data-hero-slide data-active={index === 0 ? '' : undefined}>
				<Image src={slide} alt="" widths={[640, 1080, 1600, 2400]} sizes="100vw" format="webp" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} class="hero__image" />
			</div>
		))}
	</Fragment>
	<Fragment slot="description">
		Berlin's largest student-run entrepreneurship non-profit.
	</Fragment>
</PageHero>

<script>
	import { motionEnabled, onMotionChange } from '../lib/motion';

	const slides = [...document.querySelectorAll<HTMLElement>('[data-hero-slide]')];
	let current = 0;
	let timer: number | undefined;

	const update = () => {
		window.clearInterval(timer);
		if (!motionEnabled() || slides.length < 2 || document.hidden) return;
		timer = window.setInterval(() => {
			slides[current].removeAttribute('data-active');
			current = (current + 1) % slides.length;
			slides[current].setAttribute('data-active', '');
		}, 5000);
	};
	onMotionChange(update);
	document.addEventListener('visibilitychange', update);
</script>

<style>
	.hero__slide {
		position: absolute;
		inset: 0;
		z-index: -2;
		opacity: 0;
		transition: opacity var(--duration-slideshow) ease-in-out;
	}
	.hero__slide[data-active] { opacity: 1; }
	.hero__image { width: 100%; height: 100%; object-fit: cover; }
	@media (prefers-reduced-motion: reduce) {
		.hero__slide { transition: none; }
	}
</style>
