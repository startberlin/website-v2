---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageHero from './PageHero.astro';

const slides = Object.entries(
	import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.{jpg,jpeg,png,webp}', { eager: true }),
)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, module]) => module.default);
---

<PageHero landing>
	<Fragment slot="background">
		{slides.map((slide, index) => (
			<div class="hero__slide" data-hero-slide data-active={index === 0 ? '' : undefined}>
				<Image src={slide} alt="" widths={[640, 1080, 1600, 2400]} sizes="100vw" format="webp" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} class="hero__image" />
			</div>
		))}
	</Fragment>
	<Fragment slot="title">
		<span data-hero-line data-hero-accent>Student-led.</span>
		<span data-hero-line class="hero__title--outline">Founder-minded.</span>
	</Fragment>
	<Fragment slot="description">
		START Berlin is Berlin's largest student-run entrepreneurship non-profit. As part of the START
		Network we offer students direct access to the startup world.
	</Fragment>
</PageHero>

<script>
	const slides = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
	let current = 0;

	if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		setInterval(() => {
			slides[current].removeAttribute('data-active');
			current = (current + 1) % slides.length;
			slides[current].setAttribute('data-active', '');
		}, 5000);
	}
</script>

<style>
	.hero__slide {
		position: absolute;
		inset: 0;
		z-index: -2;
		opacity: 0;
		transition: opacity var(--duration-slideshow) ease-in-out;
	}
	.hero__slide[data-active] { opacity: 1; }
	.hero__image { width: 100%; height: 100%; object-fit: cover; }
	.hero__title--outline {
		-webkit-text-stroke: 2px var(--color-white);
		-webkit-text-fill-color: transparent;
		paint-order: stroke fill;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero__slide { transition: none; }
	}
</style>
