---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Slides play in filename order: hero-1.jpg, hero-2.jpg, …
const slides = Object.entries(
	import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.{jpg,jpeg,png,webp}', { eager: true }),
)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, module]) => module.default);
---

<section class="hero">
	{
		slides.map((slide, index) => (
			<div class="hero__slide" data-hero-slide data-active={index === 0 ? '' : undefined}>
				<Image
					src={slide}
					alt=""
					widths={[640, 1080, 1600, 2400]}
					sizes="100vw"
					loading={index === 0 ? 'eager' : 'lazy'}
					fetchpriority={index === 0 ? 'high' : 'auto'}
					class="hero__image"
				/>
			</div>
		))
	}

	<div class="hero__shade hero__shade--left"></div>
	<div class="hero__shade hero__shade--bottom"></div>

	<div class="hero__blob hero__blob--1"></div>
	<div class="hero__blob hero__blob--2"></div>
	<div class="hero__blob hero__blob--3"></div>

	<div class="hero__content">
		<h1 class="hero__title">
			<span class="hero__title--accent">Student-led.</span>
			<span class="hero__title--outline">Founder-minded.</span>
		</h1>
		<p class="hero__text">
			START Berlin is Berlin's largest student-run entrepreneurship non-profit. As part of the START
			Network we offer students direct access to the startup world.
		</p>
	</div>
</section>

<script>
	const slides = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
	let current = 0;

	if (slides.length > 1) {
		setInterval(() => {
			slides[current].removeAttribute('data-active');
			current = (current + 1) % slides.length;
			slides[current].setAttribute('data-active', '');
		}, 5000);
	}
</script>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		height: calc(100vh - 5rem);
		height: calc(100svh - 5rem);
		overflow: hidden;
	}

	.hero__slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 2000ms ease-in-out;
	}

	.hero__slide[data-active] {
		opacity: 1;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.05);
	}

	.hero__shade {
		position: absolute;
		inset: 0;
	}

	.hero__shade--left {
		background: linear-gradient(
			to right,
			rgb(0 0 44 / 0.9),
			rgb(0 0 44 / 0.7),
			transparent
		);
	}

	.hero__shade--bottom {
		background: linear-gradient(to top, var(--color-dark-blue), transparent 50%);
	}

	.hero__blob {
		position: absolute;
		border-radius: 9999px;
		animation: blob 7s infinite;
	}

	.hero__blob--1 {
		top: 5rem;
		right: 15%;
		width: 500px;
		height: 500px;
		background: color-mix(in srgb, var(--color-accent) 15%, transparent);
		filter: blur(120px);
	}

	.hero__blob--2 {
		bottom: 5rem;
		left: 5%;
		width: 400px;
		height: 400px;
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		filter: blur(100px);
		animation-delay: 2s;
	}

	.hero__blob--3 {
		top: 40%;
		right: 5%;
		width: 300px;
		height: 300px;
		background: rgb(59 130 246 / 0.1);
		filter: blur(80px);
		animation-delay: 4s;
	}

	.hero__content {
		position: relative;
		width: 100%;
		max-width: 80rem;
		margin-inline: auto;
		padding-inline: 1rem;
	}

	.hero__title {
		display: flex;
		flex-direction: column;
		margin: 0 0 2rem;
		font-size: clamp(3.5rem, 8vw, 6.5rem);
		font-weight: 900;
		line-height: 0.9;
		letter-spacing: -0.025em;
		text-transform: uppercase;
		animation: rise-in 1000ms 200ms both;
	}

	.hero__title span {
		filter: drop-shadow(0 10px 8px rgb(0 0 0 / 0.04)) drop-shadow(0 4px 3px rgb(0 0 0 / 0.1));
	}

	.hero__title--accent {
		color: var(--color-accent);
	}

	.hero__title--outline {
		-webkit-text-stroke: 2px var(--color-white);
		-webkit-text-fill-color: transparent;
		paint-order: stroke fill;
	}

	.hero__text {
		max-width: 32rem;
		margin: 0 0 1.5rem;
		font-size: 1.125rem;
		line-height: 1.625;
		color: rgb(229 231 235);
		animation: rise-in 1000ms 400ms both;
	}

	@media (min-width: 640px) {
		.hero__content {
			padding-inline: 1.5rem;
		}

		.hero__text {
			font-size: 1.25rem;
		}
	}

	@media (min-width: 1024px) {
		.hero__content {
			padding-inline: 2rem;
		}
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(2rem);
		}
	}

	@keyframes blob {
		0%,
		100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(30px, -50px) scale(1.1);
		}
		66% {
			transform: translate(-20px, 20px) scale(0.9);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__slide {
			transition: none;
		}

		.hero__blob,
		.hero__title,
		.hero__text {
			animation: none;
		}
	}
</style>
