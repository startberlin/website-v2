---
import { Image, getImage } from 'astro:assets';
import artwork from '../assets/brand/start-star.webp';

// Decorative START star: the real artwork, animated by src/lib/start-star.ts once it
// is near the viewport (spikes grow out of the core, then a slow, spinnable turn).
// The animation follows the system motion setting, including changes while the page
// is open. The still artwork shows only when the animation cannot run: without
// JavaScript or WebGL, with reduced motion, or if loading fails. So nothing flashes
// before the star grows.
interface Props {
	/** Sizes hint for the still artwork. */
	sizes?: string;
	class?: string;
}

const { sizes = '(min-width: 64rem) 32rem, 80vw', class: className } = Astro.props;
// The WebGL texture uses the full 960-px artwork.
const texture = await getImage({ src: artwork, width: 960, format: 'webp' });
---

<div class:list={['star', className]} data-start-star data-texture={texture.src}>
	<Image src={artwork} alt="" widths={[480, 960]} sizes={sizes} format="webp" loading="lazy" decoding="async" class="star__still" hidden data-star-still />
	<noscript><Image src={artwork} alt="" widths={[480, 960]} sizes={sizes} format="webp" loading="lazy" decoding="async" class="star__still" /></noscript>
	<canvas class="star__canvas" aria-hidden="true"></canvas>
</div>

<style>
	.star {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ratio-square);
		/* Vertical swipes still scroll the page; other moves spin the star. */
		touch-action: pan-y;
	}

	.star :global(.star__still),
	.star__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* The artwork is drawn at 88.5 % in the canvas; match it for the still image. */
	.star :global(.star__still) {
		padding: 5.75%;
		object-fit: contain;
	}

	.star :global(.star__still[hidden]),
	.star__canvas[hidden] { display: none; }
</style>

<script>
	import { motionEnabled, onMotionChange } from '../lib/motion';
	import type { StarControl } from '../lib/start-star';

	interface Star {
		root: HTMLElement;
		still: HTMLImageElement | null;
		canvas: HTMLCanvasElement;
		near: boolean;
		loading: boolean;
		failed: boolean;
		control?: StarControl;
	}

	function webglAvailable() {
		try {
			return Boolean(document.createElement('canvas').getContext('webgl'));
		} catch {
			return false;
		}
	}

	const webgl = webglAvailable();
	const stars: Star[] = [...document.querySelectorAll<HTMLElement>('[data-start-star]')].map((root) => ({
		root,
		still: root.querySelector<HTMLImageElement>('[data-star-still]'),
		canvas: root.querySelector<HTMLCanvasElement>('.star__canvas')!,
		near: false,
		loading: false,
		failed: false,
	}));

	// Animate when possible; otherwise show the still artwork. Loads the module the
	// first time an animated star comes near the viewport.
	function update(star: Star) {
		const animate = webgl && motionEnabled() && !star.failed;
		if (star.still) star.still.hidden = animate;
		star.canvas.hidden = !animate;
		star.control?.setActive(animate);
		if (!animate || !star.near || star.control || star.loading) return;
		star.loading = true;
		import('../lib/start-star')
			.then(({ mountStar }) => mountStar(star.root))
			.then((control) => {
				star.control = control;
				update(star);
			})
			.catch(() => {
				star.failed = true;
				update(star);
			});
	}

	const loader = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const star = stars.find((candidate) => candidate.root === entry.target);
			if (!star || !entry.isIntersecting) continue;
			loader.unobserve(entry.target);
			star.near = true;
			update(star);
		}
	}, { rootMargin: '200px' });

	stars.forEach((star) => loader.observe(star.root));
	onMotionChange(() => stars.forEach(update));
</script>
