---
import { Image, getImage } from 'astro:assets';
import Icon from './icons/Icon.astro';
import artwork from '../assets/brand/start-star.webp';

// Decorative START star: the real artwork, animated by src/lib/start-star.ts once it
// is near the viewport (spikes grow out of the core, then a slow, spinnable turn).
// The still artwork shows only when the animation cannot run: without JavaScript or
// WebGL, with reduced motion, or if loading fails. So nothing flashes before it grows.
interface Props {
	/** Sizes hint for the still artwork. */
	sizes?: string;
	class?: string;
}

const { sizes = '(min-width: 64rem) 32rem, 80vw', class: className } = Astro.props;
// The WebGL texture uses the full 960-px artwork.
const texture = await getImage({ src: artwork, width: 960, format: 'webp' });
---

<div class:list={['star', className]} data-start-star data-texture={texture.src}>
	<Image src={artwork} alt="" widths={[480, 960]} sizes={sizes} format="webp" loading="lazy" decoding="async" class="star__still" hidden data-star-still />
	<noscript><Image src={artwork} alt="" widths={[480, 960]} sizes={sizes} format="webp" loading="lazy" decoding="async" class="star__still" /></noscript>
	<canvas class="star__canvas" aria-hidden="true"></canvas>
	<button type="button" class="star__toggle" hidden data-star-toggle>
		<span data-star-pause><Icon name="pause" size={18} /><span class="sr-only">Pause star animation</span></span>
		<span data-star-play hidden><Icon name="play" size={18} /><span class="sr-only">Play star animation</span></span>
	</button>
</div>

<style>
	.star {
		position: relative;
		width: 100%;
		aspect-ratio: 1;
		/* Vertical swipes still scroll the page; other moves spin the star. */
		touch-action: pan-y;
	}

	.star :global(.star__still),
	.star__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* The artwork is drawn at 88.5 % in the canvas; match it for the still image. */
	.star :global(.star__still) {
		padding: 5.75%;
		object-fit: contain;
	}

	.star :global(.star__still[hidden]) { display: none; }

	.star__toggle {
		position: absolute;
		right: 0;
		bottom: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--target-min);
		height: var(--target-min);
		padding: 0;
		color: var(--text-copy);
		border: var(--border-width) solid var(--border-default);
		border-radius: var(--radius-pill);
		background: var(--surface-status);
		cursor: pointer;
		transition: border-color var(--duration-fast), color var(--duration-fast);
	}

	.star__toggle:hover {
		color: var(--color-white);
		border-color: var(--border-accent);
	}

	.star__toggle > span { display: inline-flex; }
	.star__toggle > span[hidden] { display: none; }
</style>

<script>
	function webglAvailable() {
		try {
			return Boolean(document.createElement('canvas').getContext('webgl'));
		} catch {
			return false;
		}
	}

	const stars = [...document.querySelectorAll<HTMLElement>('[data-start-star]')];
	const showStill = (root: HTMLElement) => {
		const still = root.querySelector<HTMLImageElement>('[data-star-still]');
		if (still) still.hidden = false;
	};

	if (matchMedia('(prefers-reduced-motion: reduce)').matches || !webglAvailable()) {
		stars.forEach(showStill);
	} else {
		const loader = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const root = entry.target as HTMLElement;
				loader.unobserve(root);
				import('../lib/start-star')
					.then(({ mountStar }) => mountStar(root))
					.catch(() => showStill(root));
			}
		}, { rootMargin: '200px' });
		stars.forEach((root) => loader.observe(root));
	}
</script>
