# Runtime-only Cockpit connection. Configure these on the website server.
COCKPIT_API_URL=http://127.0.0.1:3011/api/jobboard/v1
JOBBOARD_READ_API_KEY=
JOBBOARD_SUBMIT_API_KEY=
# Canonical origin for metadata, sitemaps and job links. Use a local origin for local submission tests.
PUBLIC_SITE_URL=https://www.start-berlin.com
# Keep false for development/previews. Enable only for the approved production build AND runtime.
SITE_INDEXABLE=false
# Request metrics are disabled in this integration. This key is optional.
JOBBOARD_METRICS_ENABLED=false
JOBBOARD_METRICS_API_KEY=
