{
  "name": "website-remake",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "check:design": "node scripts/check-design.mjs",
    "check:seo": "node --import tsx scripts/check-seo.ts",
    "test:seo": "node --import tsx --test src/lib/seo/*.test.ts",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "test:jobboard": "node --import tsx --test src/lib/jobboard/*.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "build:vercel": "ASTRO_ADAPTER=vercel astro build --outDir .astro/vercel-build",
    "test:release": "node --test scripts/release/*.test.mjs",
    "smoke:local": "node scripts/release/smoke-local.mjs",
    "test": "node scripts/ci/run.mjs tests"
  },
  "dependencies": {
    "@astrojs/node": "11.1.13",
    "@astrojs/react": "7.1.9",
    "@astrojs/vercel": "11.0.22",
    "@hookform/resolvers": "7.0.6",
    "@vercel/functions": "3.11.3",
    "astro": "7.4.12",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "zod@>=4.0.0 <4.6.6": "4.6.7",
    "undici@>=8.0.0 <8.12.2": "8.12.3",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "@vercel/nft": {
      "glob": "14.0.2"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@napi-rs/wasm-runtime@1.2.4": {
      "@emnapi/runtime": "1.11.3"
    },
    "picomatch": "npm:@ryotsu/picomatch@4.0.7-a"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "packageManager": "pnpm@11.25.0"
}
