{
  "name": "website-remake",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "check:design": "node scripts/check-design.mjs",
    "check:seo": "node --import tsx scripts/check-seo.ts",
    "test:seo": "node --import tsx --test src/lib/seo/*.test.ts",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "test:jobboard": "node --import tsx --test src/lib/jobboard/*.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "build:vercel": "ASTRO_ADAPTER=vercel astro build --outDir .astro/vercel-build",
    "test:release": "node --test scripts/release/*.test.mjs",
    "smoke:local": "node scripts/release/smoke-local.mjs",
    "test": "node scripts/ci/run.mjs tests"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "7.0.0",
    "@astrojs/vercel": "11.0.12",
    "@hookform/resolvers": "5.2.2",
    "astro": "7.3.5",
    "nuqs": "2.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "sharp": "0.35.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "packageManager": "pnpm@11.25.0"
}
